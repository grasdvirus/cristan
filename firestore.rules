/**
 * @fileoverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset enforces a role-based access control model with an admin user
 * ("grasdvirus@gmail.com") who can modify all data.  Other users can only
 * access their own profile data under `/users/{userId}`. All other collections
 * are only writable by the admin.
 *
 * Data Structure:
 * - /slides/{slideId}: Slides for the hero carousel.
 * - /projects/{projectId}: Internet projects.
 * - /videos/{videoId}: TV videos.
 * - /users/{userId}: User profile information.
 *
 * Key Security Decisions:
 * - Only the admin user ("grasdvirus@gmail.com") can create, update, or delete
 *   slides, projects, and videos.
 * - Users can only read and write their own profile data.
 * - Listing slides, projects, and videos is publicly accessible.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     * @return {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user is the admin.
     * @return {boolean} True if the user is the admin, false otherwise.
     */
    function isAdmin() {
      return isSignedIn() && request.auth.token.email == "grasdvirus@gmail.com";
    }

    /**
     * @description Checks if the user is the owner of the resource.
     * @param {string} userId The user ID to check against.
     * @return {boolean} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is the owner of the existing resource.
     * @param {string} userId The user ID to check against.
     * @return {boolean} True if the user is the owner and the resource exists, false otherwise.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Security rules for the /slides collection.
     * @path /slides/{slideId}
     * @allow (get, list): Anyone can read the slides.
     * @allow (create, update, delete): Only the admin can modify slides.
     * @deny (create, update, delete): Non-admin users cannot modify slides.
     * @principle Enforces admin-only writes for slide management.
     */
    match /slides/{slideId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Security rules for the /projects collection.
     * @path /projects/{projectId}
     * @allow (get, list): Anyone can read the projects.
     * @allow (create, update, delete): Only the admin can modify projects.
     * @deny (create, update, delete): Non-admin users cannot modify projects.
     * @principle Enforces admin-only writes for project management.
     */
    match /projects/{projectId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Security rules for the /videos collection.
     * @path /videos/{videoId}
     * @allow (get, list): Anyone can read the videos.
     * @allow (create, update, delete): Only the admin can modify videos.
     * @deny (create, update, delete): Non-admin users cannot modify videos.
     * @principle Enforces admin-only writes for video management.
     */
    match /videos/{videoId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Security rules for the /users collection.
     * @path /users/{userId}
     * @allow (get, list): Only the owner can read their own profile.
     * @allow (create): Only the owner can create their own profile, and the userId must match the auth.uid.
     * @allow (update, delete): Only the owner can update or delete their own profile.
     * @deny (get, list): Other users cannot read this user's profile.
     * @deny (create): Creating a profile with a mismatched userId is forbidden.
     * @deny (update, delete): Updating or deleting another user's profile is forbidden.
     * @principle Enforces user-ownership for profile data.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }
  }
}