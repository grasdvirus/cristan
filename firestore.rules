/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for user profiles
 * and allows public read-only access to slides, projects, and videos. Contract submissions
 * are publicly readable but only writeable by authenticated users.
 *
 * Data Structure:
 * - /slides/{slideId}: Publicly readable slides for the hero carousel.
 * - /projects/{projectId}: Publicly readable internet projects.
 * - /videos/{videoId}: Publicly readable TV videos.
 * - /users/{userId}: User profile information, accessible only to the owner.
 * - /submissions/{submissionId}: Contract submissions. Publicly readable, but create and update operations are only available to authenticated users.
 *
 * Key Security Decisions:
 * - Slides, projects, and videos are publicly readable (get, list).
 * - User profiles are strictly owned; only the authenticated user can read/write their own profile.
 * - Contract submissions are publicly readable but only writeable by authenticated users.
 * - No user listing is allowed.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants public read access to slides and restricts write access.
     * @path /slides/{slideId}
     * @allow (get, list): Any user can read slide data.
     * @deny (create, update, delete): No user can create, update, or delete slides.
     * @principle Public read, owner-only writes (not applicable here as writes are denied).
     */
    match /slides/{slideId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Grants public read access to projects and restricts write access.
     * @path /projects/{projectId}
     * @allow (get, list): Any user can read project data.
     * @deny (create, update, delete): No user can create, update, or delete projects.
     * @principle Public read, owner-only writes (not applicable here as writes are denied).
     */
    match /projects/{projectId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Grants public read access to videos and restricts write access.
     * @path /videos/{videoId}
     * @allow (get, list): Any user can read video data.
     * @deny (create, update, delete): No user can create, update, or delete videos.
     * @principle Public read, owner-only writes (not applicable here as writes are denied).
     */
    match /videos/{videoId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Manages user profile access, allowing only the owner to read and write their own profile.
     * @path /users/{userId}
     * @allow (get, list): Only the user with matching userId can read.
     * @allow (create, update, delete): Only the user with matching userId can create, update, or delete.
     * @deny create: if request.auth.uid != userId;
     * @deny update: if request.auth.uid != userId;
     * @deny delete: if request.auth.uid != userId;
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId) && resource != null;
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }
   /**
     * @description Grants public read access to submissions but restricts write access to authenticated users.
     * @path /submissions/{submissionId}
     * @allow (get, list): Any user can read submission data.
     * @allow (create): Authenticated users can create submissions. Requires request.auth.uid.
     * @allow (update, delete): No user can update or delete submissions.
     * @deny create: if !isSignedIn();
     * @deny update: if true;
     * @deny delete: if true;
     * @principle Public read, authenticated user writes.
     */
    match /submissions/{submissionId} {
        allow get, list: if true;
        allow create: if isSignedIn();
        allow update: if false;
        allow delete: if false;
    }


    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
        return isSignedIn() && isOwner(userId) && resource != null;
    }
  }
}