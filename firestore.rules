/**
 * @fileoverview Firestore Security Rules.
 *
 * Core Philosophy:
 * This ruleset prioritizes security by strictly controlling access to data.
 * It uses an "owner-only" model for user profiles and allows public read access
 * for the 'slides', 'projects', and 'videos' collections while restricting
 * write access to authorized users (e.g., admins).
 *
 * Data Structure:
 * - /slides/{slideId}: Publicly readable slides for the hero carousel.
 * - /projects/{projectId}: Publicly readable projects for the 'Internet' section.
 * - /videos/{videoId}: Publicly readable videos for the 'TV' section.
 * - /users/{userId}: Private user profile data, accessible only to the user.
 *
 * Key Security Decisions:
 * - Slides, projects, and videos are publicly readable to allow open access to content.
 * - Only authenticated users can create, update, or delete slides, projects, and videos.
 * - User profiles are strictly private; only the owning user can read or write their profile.
 * - Data validation is relaxed in this prototyping phase to facilitate rapid development.
 *   However, authorization-critical fields are validated to maintain security.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to read slides, but only authenticated users to create, update, or delete them.
     * @path /slides/{slideId}
     * @allow (get, list): if true
     * @allow (create): if isSignedIn()
     * @allow (update): if isSignedIn()
     * @allow (delete): if isSignedIn()
     * @deny (create): if !isSignedIn()
     * @deny (update): if !isSignedIn()
     * @deny (delete): if !isSignedIn()
     * @principle Allows public read access to slides while restricting write access to authenticated users.
     */
    match /slides/{slideId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Allows anyone to read projects, but only authenticated users to create, update, or delete them.
     * @path /projects/{projectId}
     * @allow (get, list): if true
     * @allow (create): if isSignedIn()
     * @allow (update): if isSignedIn()
     * @allow (delete): if isSignedIn()
     * @deny (create): if !isSignedIn()
     * @deny (update): if !isSignedIn()
     * @deny (delete): if !isSignedIn()
     * @principle Allows public read access to projects while restricting write access to authenticated users.
     */
    match /projects/{projectId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Allows anyone to read videos, but only authenticated users to create, update, or delete them.
     * @path /videos/{videoId}
     * @allow (get, list): if true
     * @allow (create): if isSignedIn()
     * @allow (update): if isSignedIn()
     * @allow (delete): if isSignedIn()
     * @deny (create): if !isSignedIn()
     * @deny (update): if !isSignedIn()
     * @deny (delete): if !isSignedIn()
     * @principle Allows public read access to videos while restricting write access to authenticated users.
     */
    match /videos/{videoId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Enforces strict user-ownership for user profiles. Only the user can read, create, update, or delete their own profile.
     * @path /users/{userId}
     * @allow (get): if isOwner(userId)
     * @allow (list): if false
     * @allow (create): if isOwner(userId)
     * @allow (update): if isExistingOwner(userId)
     * @allow (delete): if isExistingOwner(userId)
     * @deny (get): if !isOwner(userId)
     * @deny (create): if !isOwner(userId)
     * @deny (update): if !isExistingOwner(userId)
     * @deny (delete): if !isExistingOwner(userId)
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
        return isOwner(userId) && exists(resource);
    }
  }
}