/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a public-read, owner-write model for most content, with user-specific profiles.
 *
 * Data Structure:
 * - Slides, Projects, Videos, Games, and Avis are top-level collections with public read access and owner-only writes.
 * - User profiles are stored under `/users/{userId}` and are only accessible to the owning user.
 * - Contract Submissions are stored under `/submissions/{submissionId}` and are only accessible to authenticated users.
 * - ReponseAvis are stored as subcollections under Avis.
 *
 * Key Security Decisions:
 * - Slides, Projects, Videos and Games can be viewed by anyone, but only modified/created/deleted by authenticated users.
 * - User listing is disallowed.
 * - By default, ambiguous relationships are secured with strict owner-only access.
 * - All write operations are validated to ensure that the user is authenticated.
 *
 * Denormalization for Authorization:
 * - The `Avis` and `ReponseAvis` collections rely on the `userId` field within each document to determine ownership. This avoids needing separate queries to authorize write operations.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user is the owner of the resource.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is the existing owner of the resource.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Slides can be read by anyone, but only created/modified/deleted by authenticated users.
     * @path /slides/{slideId}
     * @allow (get, list): Any user can read slide data.
     * @allow (create): Authenticated user can create slide.
     * @allow (update, delete): Authenticated user can update/delete slide.
     * @deny (create): Unauthenticated user cannot create slide.
     * @deny (update, delete): Unauthenticated user cannot update/delete slide.
     * @principle Allows public reads, restricts writes to authenticated users.
     */
    match /slides/{slideId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Projects can be read by anyone, but only created/modified/deleted by authenticated users.
     * @path /projects/{projectId}
     * @allow (get, list): Any user can read project data.
     * @allow (create): Authenticated user can create project.
     * @allow (update, delete): Authenticated user can update/delete project.
     * @deny (create): Unauthenticated user cannot create project.
     * @deny (update, delete): Unauthenticated user cannot update/delete project.
     * @principle Allows public reads, restricts writes to authenticated users.
     */
    match /projects/{projectId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Videos can be read by anyone, but only created/modified/deleted by authenticated users.
     * @path /videos/{videoId}
     * @allow (get, list): Any user can read video data.
     * @allow (create): Authenticated user can create video.
     * @allow (update, delete): Authenticated user can update/delete video.
     * @deny (create): Unauthenticated user cannot create video.
     * @deny (update, delete): Unauthenticated user cannot update/delete video.
     * @principle Allows public reads, restricts writes to authenticated users.
     */
    match /videos/{videoId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Games can be read by anyone, but only created/modified/deleted by authenticated users.
     * @path /games/{gameId}
     * @allow (get, list): Any user can read game data.
     * @allow (create): Authenticated user can create game.
     * @allow (update, delete): Authenticated user can update/delete game.
     * @deny (create): Unauthenticated user cannot create game.
     * @deny (update, delete): Unauthenticated user cannot update/delete game.
     * @principle Allows public reads, restricts writes to authenticated users.
     */
    match /games/{gameId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description User profiles are private and only accessible to the owning user.
     * @path /users/{userId}
     * @allow (get, list): Only the owner can read their profile.
     * @allow (create): A user can create their own profile. The userId in the path must match their auth.uid.
     * @allow (update, delete): Only the owner can update/delete their profile.
     * @deny (get, list): Another user tries to read a profile they don't own.
     * @deny (create): A user tries to create a profile with an ID that doesn't match their own.
     * @deny (update, delete): Another user tries to update/delete a profile they don't own.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Contract submissions are restricted to authenticated users.
     * @path /submissions/{submissionId}
     * @allow (get, list): Only authenticated users can read submissions.
     * @allow (create): Only authenticated users can create submissions.
     * @allow (update, delete): Only authenticated users can update/delete submissions.
     * @deny (get, list): Unauthenticated users cannot read submissions.
     * @deny (create): Unauthenticated users cannot create submissions.
     * @deny (update, delete): Unauthenticated users cannot update/delete submissions.
     * @principle Restricts access to authenticated users.
     */
    match /submissions/{submissionId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Avis can be read by anyone, but only created/modified/deleted by the owner.
     * @path /avis/{avisId}
     * @allow (get, list): Any user can read avis data.
     * @allow (create): The user creating the avis must be authenticated.
     * @allow (update, delete): Only the owner of the avis can update or delete it, and it must exist.
     * @deny (create): An unauthenticated user attempts to create an avis.
     * @deny (update, delete): A user other than the owner attempts to update/delete the avis.
     * @principle Public read, owner-only write for avis.
     */
    match /avis/{avisId} {
        allow get: if true;
        allow list: if true;
        allow create: if isSignedIn();
        allow update: if isExistingOwner(resource.data.userId);
        allow delete: if isExistingOwner(resource.data.userId);
    }

    /**
     * @description ReponseAvis are subcollections of Avis, readable by anyone, but only created/modified/deleted by the owner.
     * @path /avis/{avisId}/reponses/{reponseId}
     * @allow (get, list): Any user can read reponseAvis data.
     * @allow (create): The user creating the reponseAvis must be authenticated.
     * @allow (update, delete): Only the owner of the reponseAvis can update or delete it, and it must exist.
     * @deny (create): An unauthenticated user attempts to create an reponseAvis.
     * @deny (update, delete): A user other than the owner attempts to update/delete the reponseAvis.
     * @principle Public read, owner-only write for reponseAvis.
     */
    match /avis/{avisId}/reponses/{reponseId} {
        allow get: if true;
        allow list: if true;
        allow create: if isSignedIn();
        allow update: if isExistingOwner(resource.data.userId);
        allow delete: if isExistingOwner(resource.data.userId);
    }
  }
}