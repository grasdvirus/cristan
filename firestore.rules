/**
 * @fileoverview Firestore Security Rules for the portfolio website.
 *
 * Core Philosophy:
 * This ruleset enforces a user-ownership model for user profiles, allowing users to manage their own profiles.
 * Videos and Frameworks are publicly readable, with write access restricted (TODO).
 * Comments and Likes are linked to videos and are user-creatable under videos.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile data. Only the user can read/write their own profile.
 * - /videos/{videoId}: Stores video data. Publicly readable.
 * - /videos/{videoId}/comments/{commentId}: Stores comments on videos. Authenticated users can create comments.
 * - /videos/{videoId}/likes/{likeId}: Stores likes on videos. Authenticated users can create/delete likes.
 * - /frameworks/{frameworkId}: Stores framework data. Publicly readable.
 *
 * Key Security Decisions:
 * - User listing is disallowed.
 * - Data validation is minimized to focus on authorization and essential relational integrity.
 * - Write access to Videos and Frameworks is restricted (TODO).
 *
 * Denormalization for Authorization:
 * - Comments and Likes include the `userProfileId` to enable direct authorization without needing to fetch the user profile.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile documents.
     * @path /users/{userId}
     * @allow (create) - User with UID 'user123' can create a profile at /users/user123.
     * @allow (get, update, delete) - User with UID 'user123' can read/write their own profile at /users/user123.
     * @deny  (create) - User with UID 'user456' cannot create a profile at /users/user123.
     * @deny  (get, update, delete) - User with UID 'user456' cannot read/write the profile at /users/user123.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;

      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to video documents.
     * @path /videos/{videoId}
     * @allow (get, list) - Any user can read video documents.
     * @deny (create, update, delete) - No user can create, update, or delete video documents.
     * @principle Allows public read access but restricts write access.
     */
    match /videos/{videoId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Controls access to comment documents nested under video documents.
     * @path /videos/{videoId}/comments/{commentId}
     * @allow (create) - Any authenticated user can create a comment.
     * @allow (get, list) - Any user can read comments.
     * @deny (update, delete) - No user can update or delete comment documents.
     * @principle Allows authenticated users to create comments, with read access for all.
     */
    match /videos/{videoId}/comments/{commentId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.userProfileId == request.auth.uid && request.resource.data.videoId == videoId;
      allow update, delete: if false;
    }

    /**
     * @description Controls access to like documents nested under video documents.
     * @path /videos/{videoId}/likes/{likeId}
     * @allow (create, delete) - Any authenticated user can like/unlike a video.
     * @allow (get, list) - Any user can read likes.
     * @deny (update) - No user can update like documents.
     * @principle Allows authenticated users to create/delete likes, with read access for all.
     */
    match /videos/{videoId}/likes/{likeId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.userProfileId == request.auth.uid && request.resource.data.videoId == videoId;
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.userProfileId == request.auth.uid && resource != null;
    }

    /**
     * @description Controls access to framework documents.
     * @path /frameworks/{frameworkId}
     * @allow (get, list) - Any user can read framework documents.
     * @deny (create, update, delete) - No user can create, update, or delete framework documents.
     * @principle Allows public read access but restricts write access.
     */
    match /frameworks/{frameworkId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }
  }
}