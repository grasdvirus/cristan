/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for user profiles
 * and allows public read-only access to slides, projects, and videos. Contract submissions
 * are only writeable.
 *
 * Data Structure:
 * - /slides/{slideId}: Publicly readable slides.
 * - /projects/{projectId}: Publicly readable projects.
 * - /videos/{videoId}: Publicly readable videos.
 * - /users/{userId}: User profiles, accessible only by the owning user.
 * - /submissions/{submissionId}: Contract submissions, writeable by anyone.
 *
 * Key Security Decisions:
 * - User profiles are private and only accessible to the owning user.
 * - Slides, projects, and videos are publicly readable.
 * - Listing of user profiles is disallowed.
 * - Contract submissions are write-only, and anyone can submit.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the requesting user is signed in.
     * @return {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the requesting user is the owner of the resource.
     * @param {string} userId - The user ID to compare against the request's auth UID.
     * @return {boolean} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the requesting user is the owner of the resource and the resource exists.
     * @param {string} userId - The user ID to compare against the resource's userId.
     * @return {boolean} True if the user is the owner and the resource exists, false otherwise.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Defines security rules for the /slides/{slideId} collection.
     * @path /slides/{slideId}
     * @allow (get, list): Any user can read slides.
     * @allow (create, update, delete): No one can create, update, or delete slides.
     * @deny (create): Always denied. Slides can only be created through the CMS.
     * @principle Public read-only collection.
     */
    match /slides/{slideId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Defines security rules for the /projects/{projectId} collection.
     * @path /projects/{projectId}
     * @allow (get, list): Any user can read projects.
     * @allow (create, update, delete): No one can create, update, or delete projects.
     * @deny (create): Always denied. Projects can only be created through the CMS.
     * @principle Public read-only collection.
     */
    match /projects/{projectId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Defines security rules for the /videos/{videoId} collection.
     * @path /videos/{videoId}
     * @allow (get, list): Any user can read videos.
     * @allow (create, update, delete): No one can create, update, or delete videos.
     * @deny (create): Always denied. Videos can only be created through the CMS.
     * @principle Public read-only collection.
     */
    match /videos/{videoId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Defines security rules for the /users/{userId} collection.
     * @path /users/{userId}
     * @allow (get): Only the user can get their own profile.
     * @allow (create): Only the user can create their own profile.
     * @allow (update): Only the user can update their own profile, enforcing immutability of the user ID.
     * @allow (delete): Only the user can delete their own profile.
     * @deny (list): Listing user profiles is not allowed.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

     /**
      * @description Defines security rules for the /submissions/{submissionId} collection.
      * @path /submissions/{submissionId}
      * @allow (create): Any signed-in user can create a submission.
      * @deny (get, list, update, delete): No one can get, list, update, or delete submissions.
      * @principle Allows anyone to submit contract information, but restricts access otherwise.
      */
    match /submissions/{submissionId} {
      allow create: if isSignedIn();
      allow get, list, update, delete: if false;
    }
  }
}