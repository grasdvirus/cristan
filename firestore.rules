/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a public-read, owner-write model for 'slides', 'projects' and 'videos' collections,
 * restricts user profiles to owner-only access, and allows anyone to create 'contract submissions'.
 *
 * Data Structure:
 * - /slides/{slideId}: Publicly readable slides for the hero carousel.
 * - /projects/{projectId}: Publicly readable projects in the 'Internet' section.
 * - /videos/{videoId}: Publicly readable videos in the 'TV' section.
 * - /users/{userId}: Private user profile data, accessible only to the owning user.
 * - /submissions/{submissionId}: Contract form submissions.
 *
 * Key Security Decisions:
 * - Slides, projects and videos are publicly readable to allow for wide content distribution, but writes are not allowed.
 * - User profiles are strictly private and only accessible to the owning user.
 * - Anyone can submit a contract submission.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to read slides, but restricts writes.
     * @path /slides/{slideId}
     * @allow (get, list)
     * @deny (create, update, delete)
     * @principle Public read, no writes.
     */
    match /slides/{slideId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows anyone to read projects, but restricts writes.
     * @path /projects/{projectId}
     * @allow (get, list)
     * @deny (create, update, delete)
     * @principle Public read, no writes.
     */
    match /projects/{projectId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows anyone to read videos, but restricts writes.
     * @path /videos/{videoId}
     * @allow (get, list)
     * @deny (create, update, delete)
     * @principle Public read, no writes.
     */
    match /videos/{videoId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Manages access to user profiles, allowing only the owner to read, write, update, and delete.
     * @path /users/{userId}
     * @allow (create) User with matching id can create their profile.
     * @allow (get, list, update, delete) User can only access their own profile.
     * @deny (create) User cannot create a profile with an id that doesnt match their own.
     * @deny (get, list, update, delete) A different user cannot access this profile.
     * @principle Enforces user-owned data with ID-based matching.
     */
    match /users/{userId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && resource != null;
      allow delete: if isOwner(userId) && resource != null;
    }

       /**
        * @description Allows anyone to create contract submissions, but restricts reads, updates, and deletes.
        * @path /submissions/{submissionId}
        * @allow (create) Anyone can create a submission.
        * @deny (get, list, update, delete) No one can read, update, or delete submissions.
        * @principle Open submission, restricted access.
        */
    match /submissions/{submissionId} {
          allow create: if true;
          allow get, list, update, delete: if false;
    }

    // --- Helper functions ---

    /**
     * @description Checks if the request is made by the owner of the resource.
     * @param {string} userId The user ID to compare against the request's auth UID.
     * @return {bool} True if the request is made by the owner, false otherwise.
     */
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
  }
}