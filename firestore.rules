/**
 * @fileoverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset prioritizes security by enforcing strict access control.
 * User data is secured via an ownership model. Public data (slides, projects, videos) is readable by everyone but only writable by authenticated users.
 * All write operations require authentication.
 *
 * Data Structure:
 * - /slides/{slideId}: Public data for hero carousel slides.
 * - /projects/{projectId}: Public data for internet projects.
 * - /videos/{videoId}: Public data for TV videos.
 * - /users/{userId}: Private user profile data, accessible only by the owner.
 * - /submissions/{submissionId}: Public data for contract form submissions.
 *
 * Key Security Decisions:
 * - Public read access for slides, projects, and videos.
 * - Owner-only access to user profiles.
 * - Authenticated write access for all collections, with owner validation where applicable.
 * - No user listing is allowed.
 *
 * Denormalization for Authorization:
 * This ruleset assumes that for public collections, the documents themselves contain an `ownerId` or similar field
 * that matches the authenticated user's `uid`. This avoids costly `get()` calls to other documents.
 *
 * Structural Segregation:
 * The app uses separate collections for public (slides, projects, videos) and private (user profiles) data, improving security and performance.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to the slides collection. Slides are publicly readable, but writes are restricted to authenticated users.
     * @path /slides/{slideId}
     * @allow get, list: Everyone can read slides.
     * @allow create: Only authenticated users can create slides, and must be the owner.
     * @allow update, delete: Only the owner of a slide can update or delete it, and the slide must exist.
     * @deny create: Non-authenticated users cannot create slides.
     * @deny update, delete: Non-authenticated users cannot update or delete slides.
     * @principle Public read, owner-only writes, authenticated users.
     */
    match /slides/{slideId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Controls access to the projects collection. Projects are publicly readable, but writes are restricted to authenticated users.
     * @path /projects/{projectId}
     * @allow get, list: Everyone can read projects.
     * @allow create: Only authenticated users can create projects, and must be the owner.
     * @allow update, delete: Only the owner of a project can update or delete it, and the project must exist.
     * @deny create: Non-authenticated users cannot create projects.
     * @deny update, delete: Non-authenticated users cannot update or delete projects.
     * @principle Public read, owner-only writes, authenticated users.
     */
    match /projects/{projectId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Controls access to the videos collection. Videos are publicly readable, but writes are restricted to authenticated users.
     * @path /videos/{videoId}
     * @allow get, list: Everyone can read videos.
     * @allow create: Only authenticated users can create videos, and must be the owner.
     * @allow update, delete: Only the owner of a video can update or delete it, and the video must exist.
     * @deny create: Non-authenticated users cannot create videos.
     * @deny update, delete: Non-authenticated users cannot update or delete videos.
     * @principle Public read, owner-only writes, authenticated users.
     */
    match /videos/{videoId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Controls access to user profiles. Only the authenticated user can read or write their own profile.
     * @path /users/{userId}
     * @allow get: Only the owner can get their profile.
     * @allow list: Only the owner can list their profile.
     * @allow create: Only the owner can create their profile, and the userId must match the authenticated user's ID.
     * @allow update: Only the owner can update their profile, and the profile must exist.
     * @allow delete: Only the owner can delete their profile, and the profile must exist.
     * @deny get: Another user cannot get this user's profile.
     * @deny list: Another user cannot list this user's profile.
     * @deny create: Another user cannot create this user's profile.
     * @deny update: Another user cannot update this user's profile.
     * @deny delete: Another user cannot delete this user's profile.
     * @principle Strict user ownership for all operations.
     */
    match /users/{userId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && resource != null;
      allow delete: if isOwner(userId) && resource != null;
    }
    
    /**
     * @description Controls access to the submissions collection. Submissions are publicly readable, but writes are restricted to authenticated users.
     * @path /submissions/{submissionId}
     * @allow get, list: Everyone can read submissions.
     * @allow create: Only authenticated users can create submissions, and must be the owner.
     * @allow update, delete: Only the owner of a submission can update or delete it, and the submission must exist.
     * @deny create: Non-authenticated users cannot create submissions.
     * @deny update, delete: Non-authenticated users cannot update or delete submissions.
     * @principle Public read, owner-only writes, authenticated users.
     */
    match /submissions/{submissionId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && resource != null;
    }
  }

  // Helper function to determine if the user is signed in.
  function isSignedIn() {
    return request.auth != null;
  }

  // Helper function to determine if the user is the owner of the resource.
  function isOwner(userId) {
    return request.auth.uid == userId;
  }
}