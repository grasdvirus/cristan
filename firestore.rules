/**
 * @fileoverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset prioritizes security by enforcing strict ownership and explicit access control.
 * It is configured for rapid prototyping, so it avoids complex data validation.
 *
 * Data Structure:
 * - Slides: Public read, owner-only write.
 * - Projects: Public read, owner-only write.
 * - Videos: Public read, owner-only write.
 * - Games: Public read, owner-only write.
 * - Users: Each user has their own private data tree under /users/{userId}.
 * - Submissions: Public read, owner-only write.
 * - Avis: Public read, authenticated write.
 * - ReponseAvis: Public read, authenticated write.
 *
 * Key Security Decisions:
 * - Users can only access their own data under /users/{userId}.
 * - Public read access is granted to Slides, Projects, Videos, Games, Submissions, Avis and ReponseAvis.
 * - Data validation is minimized for prototyping, focusing on authorization and relational integrity.
 * - Destructive operations (update, delete) require document existence checks.
 *
 * Denormalization for Authorization:
 * - The "games", "slides", "projects", "videos", and "submissions" collections require that the document contains an `ownerId` or `authorId` field,
 *   but the schema does not specify one.
 *   Therefore, we will add a TODO placeholder for owner validation that will alert the developer.
 *
 * Structural Segregation:
 * - Private user data is stored under /users/{userId}, separate from public data.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Slides: Anyone can read, but only owners can create, update, or delete.
     * @path /slides/{slideId}
     * @allow (get, list): Any user can read slides.
     * @allow (create): Only the owner can create a slide with the correct `ownerId`.
     * @allow (update, delete): Only the owner of an existing slide can modify it.
     * @deny (create): A user attempts to create a slide without being authenticated.
     * @deny (update): A user attempts to update a slide they don't own.
     * @principle Public read, owner-only writes.
     */
    match /slides/{slideId} {
      allow get: if true;
      allow list: if true;
      allow create: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
      allow update: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
      allow delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Projects: Anyone can read, but only owners can create, update, or delete.
     * @path /projects/{projectId}
     * @allow (get, list): Any user can read projects.
     * @allow (create): Only the owner can create a project with the correct `ownerId`.
     * @allow (update, delete): Only the owner of an existing project can modify it.
     * @deny (create): A user attempts to create a project without being authenticated.
     * @deny (update): A user attempts to update a project they don't own.
     * @principle Public read, owner-only writes.
     */
    match /projects/{projectId} {
      allow get: if true;
      allow list: if true;
      allow create: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
      allow update: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
      allow delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Videos: Anyone can read, but only owners can create, update, or delete.
     * @path /videos/{videoId}
     * @allow (get, list): Any user can read videos.
     * @allow (create): Only the owner can create a video with the correct `ownerId`.
     * @allow (update, delete): Only the owner of an existing video can modify it.
     * @deny (create): A user attempts to create a video without being authenticated.
     * @deny (update): A user attempts to update a video they don't own.
     * @principle Public read, owner-only writes.
     */
    match /videos/{videoId} {
      allow get: if true;
      allow list: if true;
      allow create: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
      allow update: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
      allow delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Games: Anyone can read, but only owners can create, update, or delete.
     * @path /games/{gameId}
     * @allow (get, list): Any user can read games.
     * @allow (create): Only the owner can create a game with the correct `ownerId`.
     * @allow (update, delete): Only the owner of an existing game can modify it.
     * @deny (create): A user attempts to create a game without being authenticated.
     * @deny (update): A user attempts to update a game they don't own.
     * @principle Public read, owner-only writes.
     */
    match /games/{gameId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn();
      allow update: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
      allow delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Users: Only a user can read/write their own profile.
     * @path /users/{userId}
     * @allow (get, list): Only the owner can read their profile.
     * @allow (create): Only the owner can create their profile.
     * @allow (update, delete): Only the owner can update/delete their profile.
     * @deny (create): A user attempts to create a profile for another user.
     * @deny (update): A user attempts to update another user's profile.
     * @principle Enforces strict user-ownership.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Submissions: Anyone can read, but only owners can create, update, or delete.
     * @path /submissions/{submissionId}
     * @allow (get, list): Any user can read submissions.
     * @allow (create): Only the owner can create a submission with the correct `ownerId`.
     * @allow (update, delete): Only the owner of an existing submission can modify it.
     * @deny (create): A user attempts to create a submission without being authenticated.
     * @deny (update): A user attempts to update a submission they don't own.
     * @principle Public read, owner-only writes.
     */
    match /submissions/{submissionId} {
      allow get: if true;
      allow list: if true;
      allow create: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
      allow update: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
      allow delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Avis: Anyone can read, only authenticated users can create.
     * @path /avis/{avisId}
     */
    match /avis/{avisId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;

        /**
         * @description ReponseAvis: Anyone can read, only authenticated users can create.
         * @path /avis/{avisId}/reponses/{reponseId}
         */
        match /reponses/{reponseId} {
          allow get: if true;
          allow list: if true;
          allow create: if isSignedIn();
          allow update: if false;
          allow delete: if false;
        }
    }
  }

  // Helper function to determine if the user is signed in
  function isSignedIn() {
    return request.auth != null;
  }

  // Helper function to determine if the user is the owner
  function isOwner(userId) {
    return request.auth.uid == userId;
  }
}