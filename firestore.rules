/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a public-read, owner-write model for 'slides', 'projects' and 'videos' collections,
 *              owner-only access for user profiles under `/users/{userId}`, and open access to 'submissions' collection.
 *
 * Data Structure:
 * - /slides/{slideId}: Public slides for the hero carousel.
 * - /projects/{projectId}: Public internet projects.
 * - /videos/{videoId}: Public TV videos.
 * - /users/{userId}: User profiles, accessible only by the owning user.
 * - /submissions/{submissionId}: Open access for contract form submissions.
 *
 * Key Security Decisions:
 * - Slides, Projects, and Videos are publicly readable, but only owners (identified implicitly) can create, update, or delete them.
 * - User profiles are strictly private; only the owning user can read or write their profile.
 * - Contract submissions are publicly accessible.
 *
 *  NOTE: The current implementation assumes that `id` fields within the documents of `slides`, `projects`, and `videos`
 *        represent the owner of the resource.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants public read access to slides and restricts writes to owners.
     * @path /slides/{slideId}
     * @allow get, list: if true;
     * @allow create: if request.resource.data.id == request.auth.uid;
     * @allow update: if resource.data.id == request.auth.uid && resource != null;
     * @allow delete: if resource.data.id == request.auth.uid && resource != null;
     * @principle Enforces public read access with owner-only writes.
     */
    match /slides/{slideId} {
      allow get, list: if true;
      allow create: if request.auth != null && request.resource.data.id == request.auth.uid;
      allow update: if request.auth != null && get(/databases/$(database)/documents/slides/$(slideId)).data.id == request.auth.uid;
      allow delete: if request.auth != null && get(/databases/$(database)/documents/slides/$(slideId)).data.id == request.auth.uid;
    }

    /**
     * @description Grants public read access to projects and restricts writes to owners.
     * @path /projects/{projectId}
     * @allow get, list: if true;
     * @allow create: if request.resource.data.id == request.auth.uid;
     * @allow update: if resource.data.id == request.auth.uid && resource != null;
     * @allow delete: if resource.data.id == request.auth.uid && resource != null;
     * @principle Enforces public read access with owner-only writes.
     */
    match /projects/{projectId} {
      allow get, list: if true;
      allow create: if request.auth != null && request.resource.data.id == request.auth.uid;
      allow update: if request.auth != null && get(/databases/$(database)/documents/projects/$(projectId)).data.id == request.auth.uid;
      allow delete: if request.auth != null && get(/databases/$(database)/documents/projects/$(projectId)).data.id == request.auth.uid;
    }

    /**
     * @description Grants public read access to videos and restricts writes to owners.
     * @path /videos/{videoId}
     * @allow get, list: if true;
     * @allow create: if request.resource.data.id == request.auth.uid;
     * @allow update: if resource.data.id == request.auth.uid && resource != null;
     * @allow delete: if resource.data.id == request.auth.uid && resource != null;
     * @principle Enforces public read access with owner-only writes.
     */
    match /videos/{videoId} {
      allow get, list: if true;
      allow create: if request.auth != null && request.resource.data.id == request.auth.uid;
      allow update: if request.auth != null && get(/databases/$(database)/documents/videos/$(videoId)).data.id == request.auth.uid;
      allow delete: if request.auth != null && get(/databases/$(database)/documents/videos/$(videoId)).data.id == request.auth.uid;
    }

    /**
     * @description Restricts access to user profiles to the owning user.
     * @path /users/{userId}
     * @allow get: if isOwner(userId);
     * @allow list: if isOwner(userId);
     * @allow create: if isOwner(userId);
     * @allow update: if isOwner(userId) && resource != null;
     * @allow delete: if isOwner(userId) && resource != null;
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if request.auth.uid == userId;
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }
   /**
     * @description Grants public access to contract submissions
     * @path /submissions/{submissionId}
     * @allow get, list: if true;
     * @allow create: if true;
     * @allow update: if true;
     * @allow delete: if true;
     * @principle Grants all access to any authenticated user.
     */
    match /submissions/{submissionId} {
        allow get, list, create, update, delete: if true;
    }
  }

  function isSignedIn() {
    return request.auth != null;
  }

  function isOwner(userId) {
    return request.auth.uid == userId;
  }
}