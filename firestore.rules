/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for user profiles
 * and allows public read access to slides, projects, and videos. Contract submissions
 * are also publicly accessible.
 *
 * Data Structure:
 * - /slides/{slideId}: Stores hero carousel slides. Publicly readable.
 * - /projects/{projectId}: Stores internet projects. Publicly readable.
 * - /videos/{videoId}: Stores TV videos. Publicly readable.
 * - /users/{userId}: Stores user profile information. Owner-only access.
 * - /submissions/{submissionId}: Stores contract form submissions. Publicly readable.
 *
 * Key Security Decisions:
 * - Slides, projects, and videos are publicly readable, allowing anyone to get and list them.
 * - User profiles are strictly private and only accessible to the owning user.
 * - Contract Submissions are publicly readable.
 *
 * Denormalization for Authorization: N/A.  No denormalization is needed as
 * the authorization checks are straightforward (either public read or owner-only).
 *
 * Structural Segregation:  Separate collections are used for public content (slides,
 * projects, videos) and private user data (user profiles).
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows public read access to slides, but restricts writes.
     * @path /slides/{slideId}
     * @allow get, list: if true;
     * @allow create: if false;
     * @allow update: if false;
     * @allow delete: if false;
     * @principle Allows public read access.
     */
    match /slides/{slideId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows public read access to projects, but restricts writes.
     * @path /projects/{projectId}
     * @allow get, list: if true;
     * @allow create: if false;
     * @allow update: if false;
     * @allow delete: if false;
     * @principle Allows public read access.
     */
    match /projects/{projectId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows public read access to videos, but restricts writes.
     * @path /videos/{videoId}
     * @allow get, list: if true;
     * @allow create: if false;
     * @allow update: if false;
     * @allow delete: if false;
     * @principle Allows public read access.
     */
    match /videos/{videoId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Manages user profile data, restricting access to the owning user.
     * @path /users/{userId}
     * @allow get, list: if isOwner(userId);
     * @allow create: if request.auth.uid == userId;
     * @allow update: if isExistingOwner(userId);
     * @allow delete: if isExistingOwner(userId);
     * @principle Enforces document ownership for all writes.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId) && request.query.limit <= 10;
      allow create: if request.auth.uid == userId;
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Allows public read access to contract submissions, but restricts writes.
     * @path /submissions/{submissionId}
     * @allow get, list: if true;
     * @allow create, update, delete: if false;
     * @principle Allows public read access.
     */
    match /submissions/{submissionId} {
        allow get, list: if true;
        allow create, update, delete: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }
  }
}