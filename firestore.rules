/**
 * @file Firestore Security Rules
 * @core-philosophy This ruleset enforces a public read policy for certain collections
 *   (slides, projects, videos, avis) while restricting write access to authenticated users.
 *   User-specific data (user profiles) are secured with an ownership model.
 *   Submissions are restricted to authenticated users. ReponsesAvis are public for reads and secured for writes.
 * @data-structure
 *   /slides/{slideId}: Publicly readable slides.
 *   /projects/{projectId}: Publicly readable projects.
 *   /videos/{videoId}: Publicly readable videos.
 *   /users/{userId}: User profiles, only accessible by the owner.
 *   /submissions/{submissionId}: Contract submissions, only writable by authenticated users.
 *   /avis/{avisId}: Publicly readable avis.
 *   /avis/{avisId}/reponses/{reponseId}: Reponses to avis.
 * @key-security-decisions
 *   - Public read access for slides, projects, videos, and avis to allow open browsing.
 *   - Owner-only access for user profiles to protect privacy.
 *   - Authenticated user-only write access for submissions to prevent anonymous spam.
 *   - User-only access for ReponseAvis
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to read slides, but only authenticated users to create, update, or delete them.
     * @path /slides/{slideId}
     * @allow (get, list): Anyone can read slide data.
     * @allow (create, update, delete): Only authenticated users can modify slide data.
     * @deny (create, update, delete): Unauthenticated users cannot modify slide data.
     * @principle Public read, authenticated write.
     */
    match /slides/{slideId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }

    /**
     * @description Allows anyone to read projects, but only authenticated users to create, update, or delete them.
     * @path /projects/{projectId}
     * @allow (get, list): Anyone can read project data.
     * @allow (create, update, delete): Only authenticated users can modify project data.
     * @deny (create, update, delete): Unauthenticated users cannot modify project data.
     * @principle Public read, authenticated write.
     */
    match /projects/{projectId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }

    /**
     * @description Allows anyone to read videos, but only authenticated users to create, update, or delete them.
     * @path /videos/{videoId}
     * @allow (get, list): Anyone can read video data.
     * @allow (create, update, delete): Only authenticated users can modify video data.
     * @deny (create, update, delete): Unauthenticated users cannot modify video data.
     * @principle Public read, authenticated write.
     */
    match /videos/{videoId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }

    /**
     * @description Allows a user to read, create, update, and delete their own profile.
     * @path /users/{userId}
     * @allow (get, list): Only the owner can read their own profile data.
     * @allow (create): Only the owner can create their profile.
     * @allow (update, delete): Only the owner can modify their profile data.
     * @deny (get, list): Other users cannot access this profile.
     * @deny (create, update, delete): Other users cannot modify this profile.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allows only authenticated users to create submissions.  No read access.
     * @path /submissions/{submissionId}
     * @allow (create): Only authenticated users can create submissions.
     * @deny (get, list, update, delete): No one can read, list, update, or delete submissions.
     * @principle Authenticated write-only.
     */
    match /submissions/{submissionId} {
      allow get, list: if false;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    /**
     * @description Allows anyone to read avis, but only authenticated users to create, update, or delete them.
     * @path /avis/{avisId}
     * @allow (get, list): Anyone can read avis data.
     * @allow (create, update, delete): Only authenticated users can modify avis data.
     * @deny (create, update, delete): Unauthenticated users cannot modify avis data.
     * @principle Public read, authenticated write.
     */
    match /avis/{avisId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }

     /**
     * @description Allows anyone to read reponses to avis, but only authenticated users to create, update, or delete them.
     * @path /avis/{avisId}/reponses/{reponseId}
     * @allow (get, list): Anyone can read reponse data.
     * @allow (create, update, delete): Only authenticated users can modify reponse data.
     * @deny (create, update, delete): Unauthenticated users cannot modify reponse data.
     * @principle Public read, authenticated write.
     */
    match /avis/{avisId}/reponses/{reponseId} {
        allow get, list: if true;
        allow create, update, delete: if isSignedIn();
    }


    // --- Helper Functions ---

    /**
     * @description Checks if the user is signed in.
     * @return True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user is the owner of the resource based on the provided user ID.
     * @param userId The user ID to compare against the request's authentication UID.
     * @return True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is the owner of the existing resource.
     * @param userId The user ID to compare against the resource's user ID.
     * @return True if the user is the owner and the resource exists.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }
  }
}