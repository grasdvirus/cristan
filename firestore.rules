/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for user profiles
 * and allows public read-only access to slides, projects, and videos. Contract submissions
 * are only writeable.
 *
 * Data Structure:
 * - /slides/{slideId}: Publicly readable slides.
 * - /projects/{projectId}: Publicly readable projects.
 * - /videos/{videoId}: Publicly readable videos.
 * - /users/{userId}: User profiles, only accessible by the owning user.
 * - /submissions/{submissionId}: Contract submissions, only writeable.
 *
 * Key Security Decisions:
 * - Slides, projects, and videos are readable by all users, including unauthenticated users.
 * - User profiles are strictly owned by the user; only the authenticated user can read/write their own profile.
 * - Contract submissions are writeable to firebase.
 * - Listing of user documents is disallowed.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the current user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the requested user ID matches the authenticated user's ID.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the requested user ID matches the authenticated user's ID and resource exists.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Slides are publicly readable.
     * @path /slides/{slideId}
     * @allow (get, list) Any user can read slide data.
     * @deny (create, update, delete) No user can create, update, or delete slide data through client.
     * @principle Allows public read access to slide content.
     */
    match /slides/{slideId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Projects are publicly readable.
     * @path /projects/{projectId}
     * @allow (get, list) Any user can read project data.
     * @deny (create, update, delete) No user can create, update, or delete project data through client.
     * @principle Allows public read access to project content.
     */
    match /projects/{projectId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Videos are publicly readable.
     * @path /videos/{videoId}
     * @allow (get, list) Any user can read video data.
     * @deny (create, update, delete) No user can create, update, or delete video data through client.
     * @principle Allows public read access to video content.
     */
    match /videos/{videoId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description User profiles are private and only accessible to the owning user.
     * @path /users/{userId}
     * @allow (get) User can read their own profile.
     * @allow (create) User can create their own profile.
     * @allow (update) User can update their own profile.
     * @allow (delete) User can delete their own profile.
     * @deny (get) User cannot read another user's profile.
     * @deny (create) User cannot create a profile with a different user ID.
     * @deny (update) User cannot update another user's profile.
     * @deny (delete) User cannot delete another user's profile.
     * @principle Enforces document ownership for user profiles.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }
    /**
     * @description Contract submissions are writeable to firebase.
     * @path /submissions/{submissionId}
     * @allow (create) Any signed in user can create a submission.
     * @deny (get, list, update, delete) No user can get, list, update, or delete a submission through client.
     */
    match /submissions/{submissionId} {
      allow get, list: if false;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }
  }
}