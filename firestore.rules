/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for user profiles
 * and allows public read-only access to slides, projects, and videos. Contract submissions
 * are publicly readable but only writeable by authenticated users.
 *
 * Data Structure:
 * - /slides/{slideId}: Publicly readable slides for the hero carousel.
 * - /projects/{projectId}: Publicly readable internet projects.
 * - /videos/{videoId}: Publicly readable TV videos.
 * - /users/{userId}: User profile information, accessible only to the owner.
 * - /submissions/{submissionId}: Contract submissions. Publicly readable, but create and update operations are only available to authenticated users.
 *
 * Key Security Decisions:
 * - Slides, projects, and videos are publicly readable (get, list).
 * - User profiles are strictly owned; only the authenticated user can read/write their own profile.
 * - Contract submissions are publicly readable but only writeable by authenticated users.
 * - No user listing is allowed.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants public read access to slides and restricts writes.
     * @path /slides/{slideId}
     * @allow (get, list): Any user can read slides.
     * @allow (create): Authenticated users can create slides. The 'id' field must match the slideId.
     * @allow (update, delete): Only the user who created the slide can update or delete it.
     * @deny (create): An unauthenticated user attempts to create a slide.
     * @deny (update): A user attempts to update a slide they don't own.
     * @principle Public read, owner-only writes, relational integrity for 'id' field.
     */
    match /slides/{slideId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    /**
     * @description Grants public read access to projects and restricts writes.
     * @path /projects/{projectId}
     * @allow (get, list): Any user can read projects.
     * @allow (create): Authenticated users can create projects. The 'id' field must match the projectId.
     * @allow (update, delete): Only the user who created the project can update or delete it.
     * @deny (create): An unauthenticated user attempts to create a project.
     * @deny (update): A user attempts to update a project they don't own.
     * @principle Public read, owner-only writes, relational integrity for 'id' field.
     */
    match /projects/{projectId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    /**
     * @description Grants public read access to videos and restricts writes.
     * @path /videos/{videoId}
     * @allow (get, list): Any user can read videos.
     * @allow (create): Authenticated users can create videos. The 'id' field must match the videoId.
     * @allow (update, delete): Only the user who created the video can update or delete it.
     * @deny (create): An unauthenticated user attempts to create a video.
     * @deny (update): A user attempts to update a video they don't own.
     * @principle Public read, owner-only writes, relational integrity for 'id' field.
     */
    match /videos/{videoId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    /**
     * @description Enforces user-ownership for profile data.
     * @path /users/{userId}
     * @allow (get, list): Only the owner can read their own profile.
     * @allow (create): Only the user with the matching UID can create their profile. The 'id' field must match the userId.
     * @allow (update, delete): Only the owner can update or delete their profile.
     * @deny (create): A user attempts to create a profile with a mismatched user ID.
     * @deny (get, update, delete): A user attempts to access another user's profile.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Grants public read access to submissions and restricts writes to authenticated users.
     * @path /submissions/{submissionId}
     * @allow (get, list): Any user can read submissions.
     * @allow (create): Authenticated users can create submissions.
     * @allow (update, delete): No one can update or delete submissions.
     * @deny (create): An unauthenticated user attempts to create a submission.
     * @deny (update, delete): Any user attempts to update or delete a submission.
     * @principle Public read, authenticated user writes, relational integrity for 'id' field.
     */
    match /submissions/{submissionId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }
  }

  // Helper function to determine if the current user is signed in.
  function isSignedIn() {
    return request.auth != null;
  }

  // Helper function to determine if the current user is the owner of the document.
  function isOwner(userId) {
    return request.auth.uid == userId;
  }
}