/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a role-based access control model.
 *
 * Data Structure:
 * - /slides/{slideId}: Public slides for the hero carousel.
 * - /projects/{projectId}: Public projects in the 'Internet' section.
 * - /videos/{videoId}: Public videos in the 'TV' section.
 * - /users/{userId}: User profiles, accessible only to the user.
 * - /submissions/{submissionId}: Contract submissions.
 *
 * Key Security Decisions:
 * - Public read access to slides, projects, and videos.
 * - User-owned profiles with strict access control.
 *
 *
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the requested user ID matches the authenticated user's ID.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is the owner of the existing document.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Defines rules for the /slides/{slideId} collection.
     * @path /slides/{slideId}
     * @allow (get, list) - Any user can read slides.
     * @allow (create, update, delete) - No one can create, update, or delete slides through the client.
     * @deny (create, update, delete) - All writes are denied.
     * @principle Public read-only access.
     */
    match /slides/{slideId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Defines rules for the /projects/{projectId} collection.
     * @path /projects/{projectId}
     * @allow (get, list) - Any user can read projects.
     * @allow (create) - No one can create projects through the client.
     * @allow (update) - Any authenticated user can update any project.
     * @allow (delete) - No one can delete projects through the client.
     * @deny (create, delete) - All create and delete operations are denied.
     * @principle Public read, owner-only update.
     */
    match /projects/{projectId} {
      allow get, list: if true;
      allow create: if false;
      allow update: if isSignedIn();
      allow delete: if false;
    }

    /**
     * @description Defines rules for the /videos/{videoId} collection.
     * @path /videos/{videoId}
     * @allow (get, list) - Any user can read videos.
     * @allow (create, update, delete) - No one can create, update, or delete videos through the client.
     * @deny (create, update, delete) - All writes are denied.
     * @principle Public read-only access.
     */
    match /videos/{videoId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Defines rules for the /users/{userId} collection.
     * @path /users/{userId}
     * @allow (get, list) - Only the user can read their own profile.
     * @allow (create) - A user can create their own profile if the userId matches their auth.uid.
     * @allow (update) - Only the user can update their own profile.
     * @allow (delete) - Only the user can delete their own profile.
     * @deny (get, list) - Another user cannot read other user profiles.
     * @deny (create) - Another user cannot create a profile for a different user.
     * @deny (update, delete) - Another user cannot update or delete other user profiles.
     * @principle Enforces document ownership for user profiles.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

     /**
     * @description Defines rules for the /submissions/{submissionId} collection.
     * @path /submissions/{submissionId}
     * @allow get, list: if false;
     * @allow create: if isSignedIn();
     * @allow update, delete: if false;
     */
    match /submissions/{submissionId} {
      allow get, list: if false;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }
  }
}