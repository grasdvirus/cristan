/**
 * @fileoverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset prioritizes security by enforcing strict access control.
 * - Users can only read/write their own profile data.
 * - Public read access is granted for specific collections such as 'slides', 'projects', and 'videos',
 *   but write access to these collections is forbidden until owner validation is added (requires schema update).
 * - Submissions collection will have strict read and write rules to authenticated users.
 *
 * Data Structure:
 * - /slides/{slideId}: Stores publicly visible slide data.
 * - /projects/{projectId}: Stores publicly visible project data.
 * - /videos/{videoId}: Stores publicly visible video data.
 * - /users/{userId}: Stores private user profile data.
 * - /submissions/{submissionId}: Stores contract form submissions data.
 *
 * Key Security Decisions:
 * - Public listing of users is disallowed.
 * - Write access to public collections ('slides', 'projects', 'videos') is restricted until owner validation is implemented.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants public read access to slides.
     * @path /slides/{slideId}
     * @allow (get, list): Any user can read slide data.
     * @deny (create, update, delete): No user can create, update, or delete slides without owner validation.
     * @principle Allows public read access with restricted writes.
     */
    match /slides/{slideId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Grants public read access to projects.
     * @path /projects/{projectId}
     * @allow (get, list): Any user can read project data.
     * @deny (create, update, delete): No user can create, update, or delete projects without owner validation.
     * @principle Allows public read access with restricted writes.
     */
    match /projects/{projectId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Grants public read access to videos.
     * @path /videos/{videoId}
     * @allow (get, list): Any user can read video data.
     * @deny (create, update, delete): No user can create, update, or delete videos without owner validation.
     * @principle Allows public read access with restricted writes.
     */
    match /videos/{videoId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Restricts access to user profiles to the owner.
     * @path /users/{userId}
     * @allow (create): The user can create their own profile if the userId matches their auth UID.
     * @allow (get, list, update, delete): The user can only read, update, and delete their own profile.
     * @deny: Any other operation is denied.
     * @principle Enforces document ownership for user profiles.
     */
    match /users/{userId} {
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.keys().hasOnly(['bio', 'skills', 'contactInfo']);
      allow get, list: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isExistingOwner(userId) && request.resource.data.keys().hasOnly(['bio', 'skills', 'contactInfo']);
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

     /**
     * @description Restricts access to contract submissions.
     * @path /submissions/{submissionId}
     * @allow (create): Authenticated user can create.
     * @allow (get, list, update, delete): The user can only read, update, and delete their own submission.
     * @deny: Any other operation is denied.
     */
    match /submissions/{submissionId} {
       allow create: if isSignedIn() && request.resource.data.keys().hasOnly(['fullName', 'email', 'phone', 'companyName', 'projectDetails', 'projectId', 'createdAt']);
       allow get, list: if isSignedIn();
       allow update: if false;
       allow delete: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }
  }
}