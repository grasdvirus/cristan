/**
 * @file Firestore Security Rules
 * @version 2
 *
 * @description This ruleset enforces a strict ownership and admin-controlled model for data access.
 * All data is segregated into top-level collections.
 *
 * Data Structure:
 * - /slides/{slideId}: Public read, admin-only write.
 * - /projects/{projectId}: Public read, admin-only write.
 * - /videos/{videoId}: Public read, admin-only write.
 * - /users/{userId}: Owner-only read and write.
 * - /submissions/{submissionId}: Admin-only read and write.
 *
 * Key Security Decisions:
 * - Slides, Projects, and Videos are publicly readable but only modifiable by authenticated admins.
 * - User profiles are private and accessible only to the user themselves.
 * - Contract submissions are only accessible to authenticated admins.
 * - Listing of user documents is disallowed to protect privacy.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to the 'slides' collection.
     * @path /slides/{slideId}
     * @allow (get, list): Any user can read the slides.
     * @allow (create, update, delete): Only authenticated admins can modify slides.
     * @deny (create, update, delete): Non-admin users cannot modify slides.
     * @principle Public read, admin-only write.
     */
    match /slides/{slideId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Controls access to the 'projects' collection.
     * @path /projects/{projectId}
     * @allow (get, list): Any user can read the projects.
     * @allow (create, update, delete): Only authenticated admins can modify projects.
     * @deny (create, update, delete): Non-admin users cannot modify projects.
     * @principle Public read, admin-only write.
     */
    match /projects/{projectId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Controls access to the 'videos' collection.
     * @path /videos/{videoId}
     * @allow (get, list): Any user can read the videos.
     * @allow (create, update, delete): Only authenticated admins can modify videos.
     * @deny (create, update, delete): Non-admin users cannot modify videos.
     * @principle Public read, admin-only write.
     */
    match /videos/{videoId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Controls access to user profile documents.
     * @path /users/{userId}
     * @allow (get): Only the owner can read their own profile.
     * @allow (create): Only the owner can create their own profile with matching ID.
     * @allow (update, delete): Only the owner can update or delete their own profile.
     * @deny (get, list): Non-owners cannot access user profiles.
     * @principle Enforces document ownership for user profiles.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }
    
     /**
     * @description Controls access to contract submissions.
     * @path /submissions/{submissionId}
     * @allow (get, list): Only authenticated admins can read submissions.
     * @allow (create, update, delete): Only authenticated admins can manage submissions.
     * @deny (create, update, delete): Non-admin users cannot modify submissions.
     * @principle Admin-only access to sensitive contract data.
     */
    match /submissions/{submissionId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // --- Helper Functions ---

    /**
     * @description Checks if the user is signed in.
     * @return True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user is the owner of the document.
     * @param userId The user ID to compare against the request's auth UID.
     * @return True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

      /**
       * @description Check if the current user is an existing owner of the document.
       *              Combines ownership check with existence check for update/delete operations.
       * @param userId The ID of the user who should own the document.
       * @return True if the user is the owner and the document exists.
       */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Checks if the user is an administrator.
     * @return True if the user is an administrator, false otherwise.
     * @note This function currently returns false. It should be updated to reflect the actual admin status.
     */
    function isAdmin() {
      // TODO: Implement admin check using a custom claim or a document lookup.
      return false;
    }
  }
}