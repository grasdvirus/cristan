/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for user profiles
 * and allows public read-only access to slides, projects, and videos.
 *
 * Data Structure:
 * - /slides/{slideId}: Publicly readable slides for the hero carousel.
 * - /projects/{projectId}: Publicly readable internet projects.
 * - /videos/{videoId}: Publicly readable TV videos.
 * - /users/{userId}: User profiles, only accessible to the owning user.
 *
 * Key Security Decisions:
 * - Slides, projects, and videos are publicly readable to allow for easy content display. Writes are disallowed to ensure data integrity and prevent unauthorized modifications.
 * - User profiles are strictly controlled; only the owning user can create, read, update, or delete their profile.
 * - Listing of users is disallowed for privacy reasons.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows public read access to slides, but denies all write operations.
     * @path /slides/{slideId}
     * @allow (get, list) - Any user can read slide data.
     * @deny (create, update, delete) - No user can modify slide data.
     * @principle Public read, no writes.
     */
    match /slides/{slideId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows public read access to projects, but denies all write operations.
     * @path /projects/{projectId}
     * @allow (get, list) - Any user can read project data.
     * @deny (create, update, delete) - No user can modify project data.
     * @principle Public read, no writes.
     */
    match /projects/{projectId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows public read access to videos, but denies all write operations.
     * @path /videos/{videoId}
     * @allow (get, list) - Any user can read video data.
     * @deny (create, update, delete) - No user can modify video data.
     * @principle Public read, no writes.
     */
    match /videos/{videoId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Manages user profiles, ensuring only the owning user can access their data.
     * @path /users/{userId}
     * @allow (create) - A user can create their own profile if the userId matches their auth UID.
     * @allow (get, update, delete) - Only the user with a matching userId can read, update, or delete their profile.
     * @deny (list) - Listing users is not allowed.
     * @deny (create) - A user cannot create a profile with a userId that doesn't match their auth UID.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isExistingOwner(userId);
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }
  }

  function isSignedIn() {
    return request.auth != null;
  }

  function isOwner(userId) {
    return request.auth.uid == userId;
  }

    function isExistingOwner(userId) {
    return isSignedIn() && isOwner(userId) && resource != null;
  }
}