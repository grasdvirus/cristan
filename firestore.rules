/**
 * @fileoverview Firestore Security Rules for Prototyping.
 *
 * Core Philosophy:
 * This ruleset prioritizes rapid prototyping by focusing on authorization and basic relational integrity while relaxing data validation.  It enforces a strict user-ownership model for user profiles and allows public read access to other content (slides, projects, videos).
 *
 * Data Structure:
 * - /slides/{slideId}: Publicly readable collection of hero carousel slides.
 * - /projects/{projectId}: Publicly readable collection of internet projects.
 * - /videos/{videoId}: Publicly readable collection of TV videos.
 * - /users/{userId}: User profiles, accessible only to the owning user.
 *
 * Key Security Decisions:
 * - Public read access is granted to the 'slides', 'projects', and 'videos' collections to simplify initial data loading and display.
 * - User listing is disabled to protect user privacy.
 * - Write access to 'slides', 'projects', and 'videos' is open. THIS IS INSECURE AND MUST BE ADDRESSED IN PRODUCTION.
 * - Only the authenticated user can create their profile.
 * - Only the authenticated user can update or delete their profile, and only if the profile exists.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to the 'slides' collection. Allows public read access and open write access.
     * @path /slides/{slideId}
     * @allow (get, list): Any user can read slide data.
     * @allow (create, update, delete): Any user can modify slide data. THIS IS INSECURE AND MUST BE ADDRESSED IN PRODUCTION.
     * @deny (create, update, delete): No conditions under which a write is denied.
     * @principle Allows public reads for prototyping but highlights the insecure writes.
     */
    match /slides/{slideId} {
      allow get, list: if true;
      allow create, update, delete: if true; // TODO: Add authorization checks in production.
    }

    /**
     * @description Controls access to the 'projects' collection. Allows public read access and open write access.
     * @path /projects/{projectId}
     * @allow (get, list): Any user can read project data.
     * @allow (create, update, delete): Any user can modify project data. THIS IS INSECURE AND MUST BE ADDRESSED IN PRODUCTION.
     * @deny (create, update, delete): No conditions under which a write is denied.
     * @principle Allows public reads for prototyping but highlights the insecure writes.
     */
    match /projects/{projectId} {
      allow get, list: if true;
      allow create, update, delete: if true; // TODO: Add authorization checks in production.
    }

    /**
     * @description Controls access to the 'videos' collection. Allows public read access and open write access.
     * @path /videos/{videoId}
     * @allow (get, list): Any user can read video data.
     * @allow (create, update, delete): Any user can modify video data. THIS IS INSECURE AND MUST BE ADDRESSED IN PRODUCTION.
     * @deny (create, update, delete): No conditions under which a write is denied.
     * @principle Allows public reads for prototyping but highlights the insecure writes.
     */
    match /videos/{videoId} {
      allow get, list: if true;
      allow create, update, delete: if true; // TODO: Add authorization checks in production.
    }

    /**
     * @description Controls access to user profiles. Only the authenticated user can read, update, or delete their own profile.
     * @path /users/{userId}
     * @allow (create): Only the authenticated user can create their own profile.
     * @allow (get, update, delete): Only the authenticated user can access and modify their own profile.
     * @deny (list): Listing of users is not allowed.
     * @deny (create): Prevents creating a user profile with a mismatched user ID.
     * @deny (get, update, delete): Prevents access to other user's profiles.
     * @principle Enforces document ownership for user profiles.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }
  }

  // Helper functions
  function isSignedIn() {
    return request.auth != null;
  }

  function isOwner(userId) {
    return isSignedIn() && request.auth.uid == userId;
  }

    //  Combines the ownership check with the existence check.
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }
}