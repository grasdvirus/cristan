/**
 * @fileoverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset prioritizes administrative control. Authenticated administrators have full access to all data.
 * Non-admin users are restricted to managing their own user profiles.
 *
 * Data Structure:
 * - /slides/{slideId}: Stores data for the hero carousel.
 * - /projects/{projectId}: Stores data for internet projects.
 * - /videos/{videoId}: Stores data for TV videos.
 * - /users/{userId}: Stores user profile data, accessible only to the user themselves.
 *
 * Key Security Decisions:
 * - Administrators (defined by the `isAdmin()` function) bypass all other security checks.
 * - Non-administrators can only read and write their own user profiles under `/users/{userId}`.
 * - Listing of users is disallowed.
 *
 * Denormalization for Authorization:
 * - An `isAdmin` claim on the user's auth token is used to grant administrative privileges.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     * @return {bool} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user is an admin based on a custom claim.
     * @return {bool} True if the user is an admin, false otherwise.
     */
    function isAdmin() {
      return isSignedIn() && request.auth.token.isAdmin == true;
    }

    /**
     * @description Checks if the authenticated user ID matches the provided user ID.
     * @param {string} userId The user ID to compare against.
     * @return {bool} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is the existing owner of the document.
     * @param {string} userId The user ID to compare against.
     * @return {bool} True if the user is the owner and the document exists.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Rules for the /slides collection. Allows admins full control.
     * @path /slides/{slideId}
     * @allow (create) If the user is an admin.
     * @deny (create) If the user is not an admin.
     * @allow (get) If the user is an admin.
     * @deny (get) If the user is not an admin.
     * @principle Allows admin to fully manage the slides collection.
     */
    match /slides/{slideId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Rules for the /projects collection. Allows admins full control.
     * @path /projects/{projectId}
     * @allow (create) If the user is an admin.
     * @deny (create) If the user is not an admin.
     * @allow (get) If the user is an admin.
     * @deny (get) If the user is not an admin.
     * @principle Allows admin to fully manage the projects collection.
     */
    match /projects/{projectId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Rules for the /videos collection. Allows admins full control.
     * @path /videos/{videoId}
     * @allow (create) If the user is an admin.
     * @deny (create) If the user is not an admin.
     * @allow (get) If the user is an admin.
     * @deny (get) If the user is not an admin.
     * @principle Allows admin to fully manage the videos collection.
     */
    match /videos/{videoId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Rules for the /users collection. Allows a user to manage their own profile, and admins to have full access.
     * @path /users/{userId}
     * @allow (create) If the user is creating their own profile.
     * @deny (create) If the user is not creating their own profile.
     * @allow (get) If the user is an admin or the user is getting their own profile.
     * @deny (get) If the user is not an admin or getting their own profile.
     * @principle Allows a user to manage their own profile.
     */
    match /users/{userId} {
      allow get: if isAdmin() || isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isAdmin() || isExistingOwner(userId);
      allow delete: if isAdmin() || isExistingOwner(userId);
    }
  }
}