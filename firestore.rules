rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows public read access to slides. Writes are not defined and thus forbidden.
     * @path /slides/{slideId}
     * @allow get, list: Any user can read slide data.
     * @deny create, update, delete: No user can create, update, or delete slide data.
     * @principle Allows public reads.
     */
    match /slides/{slideId} {
      allow get, list: if true;
    }

    /**
     * @description Allows public read access to projects. Writes are not defined and thus forbidden.
     * @path /projects/{projectId}
     * @allow get, list: Any user can read project data.
     * @deny create, update, delete: No user can create, update, or delete project data.
     * @principle Allows public reads.
     */
    match /projects/{projectId} {
      allow get, list: if true;
    }

    /**
     * @description Allows public read access to videos. Writes are not defined and thus forbidden.
     * @path /videos/{videoId}
     * @allow get, list: Any user can read video data.
     * @deny create, update, delete: No user can create, update, or delete video data.
     * @principle Allows public reads.
     */
    match /videos/{videoId} {
      allow get, list: if true;
    }

    /**
     * @description Manages access control for user profiles.
     * @path /users/{userId}
     * @allow get, list: Only the owner can get or list their own user profile.
     * @allow create: Only the owner can create their own user profile, and the user ID must match the authenticated user's ID.
     * @allow update: Only the owner can update their own user profile, and the user ID must match the authenticated user's ID.
     * @allow delete: Only the owner can delete their own user profile.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if request.auth.uid == userId;
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }
        /**
     * @description Denies listing contract submissions.
     * @path /submissions/{submissionId}
     * @deny list: Listing submissions is denied.
     * @allow get, create, update, delete:  Access is denied.
     */
    match /submissions/{submissionId} {
        allow get, create, update, delete: if false;
        allow list: if false;
    }


    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }
  }
}