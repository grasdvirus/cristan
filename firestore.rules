/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a multi-layered security model, balancing open read access with strict ownership and authentication requirements for write operations.
 *
 * Data Structure:
 * - Slides, Projects, Videos, and Games are stored in top-level collections with public read access.
 * - User profiles are stored under `/users/{userId}`.
 * - Contract submissions are stored under `/submissions/{submissionId}`.
 * - Reviews (Avis) are stored under `/avis/{avisId}`, with responses (ReponseAvis) in a subcollection.
 *
 * Key Security Decisions:
 * - Slides, Projects, Videos, and Games: Publicly readable but only writeable with valid authentication. The creator must include their `uid` as the author on creation, and only the author can modify or delete.
 * - User Profiles: Only a user can read/write their own profile.
 * - Contract Submissions: Only authenticated users can create submissions.
 * - Reviews (Avis): Publicly readable, but writeable only by authenticated users with the correct user ID.
 * - Responses (ReponseAvis):  Writeable only by authenticated users with the correct user ID, linked to the parent Avis.
 * - Listing of User Profiles: Listing user profiles is not permitted.
 *
 * Denormalization for Authorization:
 * - For public read collections (Slides, Projects, Videos, Games, Avis, ReponseAvis), documents must include an `ownerId` or `authorId` field to enforce write permissions.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to read Slides, but only allows authenticated users to create, update, or delete them if they are the owner.
     * @path /slides/{slideId}
     * @allow (get, list)
     * @allow (create) - authenticated user with request.resource.data.ownerId set to their UID.
     * @allow (update, delete) - authenticated user who is the owner (resource.data.ownerId == request.auth.uid).
     * @deny (create) - unauthenticated user.
     * @deny (update, delete) - unauthenticated user, or authenticated user who is not the owner.
     * @principle Public read, owner-only writes.
     */
    match /slides/{slideId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
    }

    /**
     * @description Allows anyone to read Projects, but only allows authenticated users to create, update, or delete them if they are the owner.
     * @path /projects/{projectId}
     * @allow (get, list)
     * @allow (create) - authenticated user with request.resource.data.ownerId set to their UID.
     * @allow (update, delete) - authenticated user who is the owner (resource.data.ownerId == request.auth.uid).
     * @deny (create) - unauthenticated user.
     * @deny (update, delete) - unauthenticated user, or authenticated user who is not the owner.
     * @principle Public read, owner-only writes.
     */
    match /projects/{projectId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
    }

    /**
     * @description Allows anyone to read Videos, but only allows authenticated users to create, update, or delete them if they are the owner.
     * @path /videos/{videoId}
     * @allow (get, list)
     * @allow (create) - authenticated user with request.resource.data.ownerId set to their UID.
     * @allow (update, delete) - authenticated user who is the owner.
     * @deny (create) - unauthenticated user.
     * @deny (update, delete) - unauthenticated user, or authenticated user who is not the owner.
     * @principle Public read, owner-only writes.
     */
    match /videos/{videoId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
    }

    /**
     * @description Allows anyone to read Games, but only allows authenticated users to create, update, or delete them if they are the owner.
     * @path /games/{gameId}
     * @allow (get, list)
     * @allow (create) - authenticated user with request.resource.data.ownerId set to their UID.
     * @allow (update, delete) - authenticated user who is the owner.
     * @deny (create) - unauthenticated user.
     * @deny (update, delete) - unauthenticated user, or authenticated user who is not the owner.
     * @principle Public read, owner-only writes.
     */
    match /games/{gameId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
    }

    /**
     * @description Allows a user to read and write their own profile.
     * @path /users/{userId}
     * @allow (get, create, update, delete) - authenticated user where userId matches request.auth.uid.
     * @deny (get, create, update, delete) - unauthenticated user, or authenticated user where userId does not match request.auth.uid.
     * @deny (list) - prevents listing all user profiles.
     * @principle Enforces document ownership for writes. Restricts access to a user's own data tree.
     */
    match /users/{userId} {
      allow get, create, update, delete: if isOwner(userId);
      allow list: if false;
    }

    /**
     * @description Allows any authenticated user to create a contract submission.
     * @path /submissions/{submissionId}
     * @allow (create) - authenticated user.
     * @deny (get, list, update, delete) - all users.
     * @principle Authenticated users can create submissions.
     */
    match /submissions/{submissionId} {
        allow create: if isSignedIn();
      allow get, list, update, delete: if false;
    }

    /**
     * @description Allows anyone to read Avis, but only allows authenticated users to create, update, or delete them if they are the owner.
     * @path /avis/{avisId}
     * @allow (get, list)
     * @allow (create) - authenticated user with request.resource.data.userId set to their UID.
     * @allow (update, delete) - authenticated user who is the owner.
     * @deny (create) - unauthenticated user.
     * @deny (update, delete) - unauthenticated user, or authenticated user who is not the owner.
     * @principle Public read, owner-only writes.
     */
    match /avis/{avisId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && request.resource.data.userId == request.auth.uid;

        /**
         * @description Allows anyone to read ReponseAvis, but only allows authenticated users to create, update, or delete them if they are the owner.
         * @path /avis/{avisId}/reponses/{reponseId}
         * @allow (get, list)
         * @allow (create) - authenticated user with request.resource.data.userId set to their UID.
         * @allow (update, delete) - authenticated user who is the owner.
         * @deny (create) - unauthenticated user.
         * @deny (update, delete) - unauthenticated user, or authenticated user who is not the owner.
         * @principle Public read, owner-only writes.
         */
        match /reponses/{reponseId} {
          allow get, list: if true;
          allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
          allow update, delete: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        }
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }
  }
}