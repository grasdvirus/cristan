/**
 * @file Firestore Security Rules
 * @description This ruleset defines access control for the Firestore database, balancing security with ease of iteration.
 *
 * Core Philosophy:
 * The security model emphasizes strict data ownership and role-based access control where appropriate.
 *  - Users can only read and write their own profiles.
 *  - Slides, Projects, and Videos collections are publicly readable but only writable by authenticated users who set the correct author.
 *  - Submissions should be restricted to authenticated users.
 *
 * Data Structure:
 * - /slides/{slideId}: Stores slide data (public read, owner-only write).
 * - /projects/{projectId}: Stores project data (public read, owner-only write).
 * - /videos/{videoId}: Stores video data (public read, owner-only write).
 * - /users/{userId}: Stores user profiles (owner-only access).
 * - /submissions/{submissionId}: Stores contract submissions (authenticated users only).
 *
 * Key Security Decisions:
 * - User listing is explicitly denied to protect user privacy.
 * - The rules are designed to be permissive regarding data shapes to facilitate rapid prototyping. Data validation beyond ownership and relational integrity checks is omitted.
 *
 * Denormalization for Authorization:
 * - Slides, Projects, and Videos will require an `ownerId` or `authorId` field to enforce owner-only writes.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is authenticated.
     * @return {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user is the owner of the resource.
     * @param {string} userId - The user ID to compare against the authenticated user's ID.
     * @return {boolean} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is the owner of the existing resource.
     * @param {string} userId - The user ID to compare against the authenticated user's ID.
     * @return {boolean} True if the user is the owner and the resource exists, false otherwise.
     */
    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }

    /**
     * @description Rules for the /slides collection.
     * @path /slides/{slideId}
     * @allow (get, list): Anyone can read slides.
     * @allow (create): Authenticated user can create a slide if they set the 'authorId' field to their own UID.
     * @allow (update, delete): Only the author can update or delete a slide, and only if it exists.
     * @deny (create): If the 'authorId' field does not match the authenticated user's UID.
     * @deny (update, delete): If the slide does not exist.
     * @principle Allows public read access, but restricts write access to the owner.
     */
    match /slides/{slideId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.id == slideId;
      allow update: if isExistingOwner(resource.data.id);
      allow delete: if isExistingOwner(resource.data.id);
    }

    /**
     * @description Rules for the /projects collection.
     * @path /projects/{projectId}
     * @allow (get, list): Anyone can read projects.
     * @allow (create): Authenticated user can create a project if they set the 'authorId' field to their own UID.
     * @allow (update, delete): Only the author can update or delete a project, and only if it exists.
     * @deny (create): If the 'authorId' field does not match the authenticated user's UID.
     * @deny (update, delete): If the project does not exist.
     * @principle Allows public read access, but restricts write access to the owner.
     */
    match /projects/{projectId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.id == projectId;
      allow update: if isExistingOwner(resource.data.id);
      allow delete: if isExistingOwner(resource.data.id);
    }

    /**
     * @description Rules for the /videos collection.
     * @path /videos/{videoId}
     * @allow (get, list): Anyone can read videos.
     * @allow (create): Authenticated user can create a video if they set the 'authorId' field to their own UID.
     * @allow (update, delete): Only the author can update or delete a video, and only if it exists.
     * @deny (create): If the 'authorId' field does not match the authenticated user's UID.
     * @deny (update, delete): If the video does not exist.
     * @principle Allows public read access, but restricts write access to the owner.
     */
    match /videos/{videoId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.id == videoId;
      allow update: if isExistingOwner(resource.data.id);
      allow delete: if isExistingOwner(resource.data.id);
    }

    /**
     * @description Rules for the /users collection.
     * @path /users/{userId}
     * @allow (create): A user can create their own profile if the userId matches their auth.uid.
     * @allow (get, update, delete): A user can only access and modify their own profile.
     * @deny (list): User listing is not allowed.
     * @principle Enforces strict user-ownership for profile data.
     */
    match /users/{userId} {
      allow get, update, delete: if isExistingOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow list: if false;
    }

    /**
     * @description Rules for the /submissions collection.
     * @path /submissions/{submissionId}
     * @allow (get, list, create): Any authenticated user can list, get, and create submissions.
     * @deny (update, delete): Submissions cannot be updated or deleted.
     * @principle Allows authenticated users to submit contract information.
     */
    match /submissions/{submissionId} {
      allow get, list, create: if isSignedIn();
      allow update, delete: if false;
    }
  }
}