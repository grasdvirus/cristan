rules_version = '2';
service cloud.firestore {
    
      match /databases/{database}/documents {
            
                function isAdmin() {
                        return request.auth != null && request.auth.token.email == 'grasdvirus@gmail.com';
                }

                    match /users/{userId} {
                            allow read, write: if request.auth != null && request.auth.uid == userId;
                                  allow list: if false;
                    }

                        match /videos/{videoId} {
                                allow get, list: if true;
                                      allow create, update, delete: if isAdmin();

                                            match /comments/{commentId} {
                                                      allow get, list: if true;
                                                              allow create: if request.auth != null;
                                                                      allow update, delete: if false; 
                                            }

                                                  match /likes/{likeId} {
                                                            allow get, list: if true;
                                                                    allow create: if request.auth != null;
                                                                            allow delete: if request.auth != null && resource.data.userProfileId == request.auth.uid;
                                                                                    allow update: if false;
                                                  }
                        }

                            match /frameworks/{frameworkId} {
                                    allow get, list: if true;
                                          allow create, update, delete: if isAdmin();
                            }
                                
                                    match /projects/{projectId} {
                                            allow get, list: if true;
                                                  allow create, update, delete: if isAdmin();
                                    }

                                        match /slides/{slideId} {
                                                allow get, list: if true;
                                                      allow create, update, delete: if isAdmin();
                                        }
                                            
                                                match /submissions/{submissionId} {
                                                        // Permet à l'admin de tout voir, ou à l'utilisateur de voir sa propre soumission
                                                              allow get: if isAdmin() || (request.auth != null && request.auth.uid == submissionId);
                                                                    
                                                                          // Seul l'admin peut lister toutes les soumissions
                                                                                allow list: if isAdmin();
                                                                                      
                                                                                            // N'importe quel utilisateur authentifié peut créer une soumission
                                                                                                  // avec son propre userId comme ID de document
                                                                                                        allow create: if request.auth != null && 
                                                                                                                              request.resource.data.userId == request.auth.uid && 
                                                                                                                                                    submissionId == request.auth.uid;
                                                                                                                                                          
                                                                                                                                                                // Seul l'admin peut mettre à jour (pour changer le statut, promoCodeUses, etc.)
                                                                                                                                                                      allow update: if isAdmin();
                                                                                                                                                                            
                                                                                                                                                                                  // Seul l'admin peut supprimer
                                                                                                                                                                                        allow delete: if isAdmin();
                                                }
                                                    
                                                        match /avis/{avisId} {
                                                                allow get, list: if true;
                                                                      allow create: if request.auth != null;
                                                                            allow update, delete: if false;
                                                                                  
                                                                                        match /reponses/{reponseId} {
                                                                                                   allow get, list: if true;
                                                                                                            allow create: if request.auth != null;
                                                                                                                     allow update, delete: if false;
                                                                                        }
                                                        }

                                                            match /games/{gameId} {
                                                                    allow get, list: if true;
                                                                          allow create, update, delete: if isAdmin();
                                                            }
      }
}
