/**
 * @file Firestore Security Rules
 * @description This ruleset is designed for a prototying environment and prioritizes security through strict authorization,
 *              while remaining flexible on data shapes to allow rapid iteration.
 *
 * Core Philosophy:
 * This ruleset enforces a mixed security model. Data in top-level collections such as 'slides', 'projects', 'videos', and 'games' is publicly readable,
 * but write access is not defined due to missing `ownerId` field. Data under `/users/{userId}` is strictly owned by the user.
 * The contract submissions collection is write-protected.
 * Reviews/comments ('avis') are publicly readable but write access is not defined.
 *
 * Data Structure:
 * - /slides/{slideId}: Publicly readable slides for the hero carousel.
 * - /projects/{projectId}: Publicly readable projects in the "Internet" section.
 * - /videos/{videoId}: Publicly readable videos in the "TV" section.
 * - /games/{gameId}: Publicly readable games for affiliation.
 * - /users/{userId}: User profile information, accessible only by the user.
 * - /submissions/{submissionId}: Contract form submissions, write-protected.
 * - /avis/{avisId}: Reviews/comments, write-protected, with replies nested under each review.
 *
 * Key Security Decisions:
 * - Public Read Access: The 'slides', 'projects', 'videos', and 'games' collections are publicly readable to enable open content consumption.
 * - Strict User Ownership: The `/users/{userId}` collection enforces strict user ownership, ensuring that only the authenticated user can access their profile data.
 * - Write Protection: The submissions collection and reviews are write protected due to a lack of defined ownership.
 * - Missing Ownership Fields: Several entities lack a clear 'ownerId' field, making it impossible to implement secure owner-only write rules. Placeholder rules and comments are added to highlight these areas.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants public read access to slides, but restricts writes.
     * @path /slides/{slideId}
     * @allow (get, list): Any user can read slide data.
     * @deny (create, update, delete): No user can create, update, or delete slides.
     * @principle Allows public read access while restricting write access due to missing ownership.
     */
    match /slides/{slideId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Grants public read access to projects, but restricts writes.
     * @path /projects/{projectId}
     * @allow (get, list): Any user can read project data.
     * @deny (create, update, delete): No user can create, update, or delete projects.
     * @principle Allows public read access while restricting write access due to missing ownership.
     */
    match /projects/{projectId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Grants public read access to videos, but restricts writes.
     * @path /videos/{videoId}
     * @allow (get, list): Any user can read video data.
     * @deny (create, update, delete): No user can create, update, or delete videos.
     * @principle Allows public read access while restricting write access due to missing ownership.
     */
    match /videos/{videoId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Grants public read access to games, but restricts writes.
     * @path /games/{gameId}
     * @allow (get, list): Any user can read game data.
     * @deny (create, update, delete): No user can create, update, or delete games.
     * @principle Allows public read access while restricting write access due to missing ownership.
     */
    match /games/{gameId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Manages user profile data, allowing only the owner to read and write.
     * @path /users/{userId}
     * @allow (get, list): Authenticated user can read their own profile.
     * @allow (create): Authenticated user can create their own profile, but the `userId` in the document must match `auth.uid`.
     * @allow (update, delete): Authenticated user can update/delete their own profile.
     * @deny (get, list): Non-owner users cannot read other user's profile.
     * @deny (create, update, delete): Non-owner users cannot create, update or delete user profiles.
     * @principle Enforces strict user ownership for profiles.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

   /**
     * @description Restricts all access to contract submissions.
     * @path /submissions/{submissionId}
     * @allow (get, list, create, update, delete): No user can get, list, create, update, or delete submissions.
     * @principle Restricts access to contract submissions.
     */
    match /submissions/{submissionId} {
        allow get: if false;
        allow list: if false;
        allow create: if false;
        allow update: if false;
        allow delete: if false;
    }

    /**
     * @description Grants public read access to avis, but restricts writes.
     * @path /avis/{avisId}
     * @allow (get, list): Any user can read avis data.
     * @deny (create, update, delete): No user can create, update, or delete avis.
     * @principle Allows public read access while restricting write access due to missing ownership.
     */
    match /avis/{avisId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.

          /**
           * @description Manages replies to avis, write access is not defined.
           * @path /avis/{avisId}/reponses/{reponseId}
           * @allow (get, list): Any user can read reponses data.
           * @deny (create, update, delete): No user can create, update, or delete reponses.
           * @principle Allows public read access while restricting write access due to missing ownership.
           */
          match /reponses/{reponseId} {
            allow get, list: if true;
            allow create, update, delete: if false;  // TODO: Add owner validation once the schema is updated with an ownership field.
          }
    }

    /**
     * @description Checks if the current user is signed in.
     * @return {bool} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the current user is the owner of the resource.
     * @param {string} userId - The user ID to compare with the request's authentication UID.
     * @return {bool} True if the user is the owner, false otherwise.
     * @example allow read: if isOwner("someUserId");
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the current user is the owner of an existing resource.
     * @param {string} userId - The user ID to compare with the resource's user ID.
     * @return {bool} True if the user is the owner and the resource exists.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }
  }
}