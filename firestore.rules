/**
 * @fileoverview Firestore Security Rules.
 *
 * Core Philosophy:
 * This ruleset prioritizes secure access to user-specific data while allowing public read access to certain collections.
 * User authentication is enforced for all write operations and for accessing user-specific data.
 *
 * Data Structure:
 * - /slides/{slideId}: Publicly readable collection for hero carousel slides.  Write access is not granted.
 * - /projects/{projectId}: Publicly readable collection for internet projects. Write access is not granted.
 * - /videos/{videoId}: Publicly readable collection for TV videos. Write access is not granted.
 * - /users/{userId}: Stores individual user profiles. Access is restricted to the owning user.
 * - /submissions/{submissionId}: Stores contact form submissions. Write access is not granted.
 *
 * Key Security Decisions:
 * - Public Read Access: Slides, Projects, and Videos are publicly readable.
 * - User Ownership: User profiles under /users/{userId} are strictly owned by the authenticated user.
 * - No Listing of Users: Listing the /users collection is not permitted.
 * - Flexible Data Shapes: The rules do not enforce strict schema validation beyond authorization checks.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows read access to slides; write access is denied.
     * @path /slides/{slideId}
     * @allow (get, list): Any user can read slides.
     * @deny (create, update, delete): No user can create, update, or delete slides.
     * @principle Public read access, no write access.
     */
    match /slides/{slideId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows read access to projects; write access is denied.
     * @path /projects/{projectId}
     * @allow (get, list): Any user can read projects.
     * @deny (create, update, delete): No user can create, update, or delete projects.
     * @principle Public read access, no write access.
     */
    match /projects/{projectId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows read access to videos; write access is denied.
     * @path /videos/{videoId}
     * @allow (get, list): Any user can read videos.
     * @deny (create, update, delete): No user can create, update, or delete videos.
     * @principle Public read access, no write access.
     */
    match /videos/{videoId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows a user to read, create, update, and delete their own profile.
     * @path /users/{userId}
     * @allow (get, list): The user can read/list their own profile.
     * @allow (create): The user can create their own profile.
     * @allow (update, delete): The user can update/delete their own profile.
     * @deny: Other users cannot access this data.
     * @principle Enforces document ownership.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

      /**
       * @description Allows read access to submissions; write access is denied.
       * @path /submissions/{submissionId}
       * @allow (get, list): Any user can read submissions.
       * @deny (create, update, delete): No user can create, update, or delete submissions.
       * @principle Public read access, no write access.
       */
      match /submissions/{submissionId} {
        allow get, list: if true;
        allow create, update, delete: if false;
      }

    // ------ Helper Functions ------

    /**
     * @description Checks if the current user is signed in.
     * @return {bool} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the current user is the owner of the document.
     * @param {string} userId The user ID to check against.
     * @return {bool} True if the user is the owner, false otherwise.
     * @example: allow read: if isOwner("user123");
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the current user is the owner of the document and if the document exists.
     * @param {string} userId The user ID to check against.
     * @return {bool} True if the user is the owner and the document exists, false otherwise.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }
  }
}