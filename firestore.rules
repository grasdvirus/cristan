/**
 * @fileoverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset prioritizes security by enforcing strict access control based on
 * ownership and explicit permissions. Data validation is relaxed to facilitate
 * rapid prototyping.
 *
 * Data Structure:
 * - /slides/{slideId}: Publicly readable slides for the hero carousel.  Only authenticated users can create, update, or delete slides.
 * - /projects/{projectId}: Publicly readable projects. Only authenticated users can create, update, or delete projects.
 * - /videos/{videoId}: Publicly readable videos. Only authenticated users can create, update, or delete videos.
 * - /users/{userId}:  User profiles, accessible only to the owning user.
 *
 * Key Security Decisions:
 * - Public read access is granted for /slides, /projects, and /videos to support
 *   unauthenticated browsing.
 * - All write operations require authentication.
 * - User listing is disabled to prevent information harvesting.
 *
 * Denormalization for Authorization:
 *  - Public collections (/slides, /projects, /videos) do not have an explicit `ownerId` field, but still require authentication to create, update or delete to prevent anonymous writes.
 *
 * Structural Segregation:
 * - Private user data is stored under the /users/{userId} path, separate from
 *   publicly readable data.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to read slides, but only authenticated users can create, update, or delete them.
     * @path /slides/{slideId}
     * @allow (get, list): Always. Slides are publicly readable.
     * @allow (create): Only if the user is authenticated.
     * @allow (update, delete): Only if the user is authenticated and the document exists.
     * @deny (create): If the user is not authenticated.
     * @deny (update, delete): If the user is not authenticated or the document does not exist.
     * @principle Public read, authenticated writes.
     */
    match /slides/{slideId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Allows anyone to read projects, but only authenticated users can create, update, or delete them.
     * @path /projects/{projectId}
     * @allow (get, list): Always. Projects are publicly readable.
     * @allow (create): Only if the user is authenticated.
     * @allow (update, delete): Only if the user is authenticated and the document exists.
     * @deny (create): If the user is not authenticated.
     * @deny (update, delete): If the user is not authenticated or the document does not exist.
     * @principle Public read, authenticated writes.
     */
    match /projects/{projectId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Allows anyone to read videos, but only authenticated users can create, update, or delete them.
     * @path /videos/{videoId}
     * @allow (get, list): Always. Videos are publicly readable.
     * @allow (create): Only if the user is authenticated.
     * @allow (update, delete): Only if the user is authenticated and the document exists.
     * @deny (create): If the user is not authenticated.
     * @deny (update, delete): If the user is not authenticated or the document does not exist.
     * @principle Public read, authenticated writes.
     */
    match /videos/{videoId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Allows a user to read, create, update, and delete their own profile.
     * @path /users/{userId}
     * @allow (get, list): Only if the user is the owner of the profile.
     * @allow (create): Only if the user is creating their own profile.
     * @allow (update, delete): Only if the user is the owner of the profile and the document exists.
     * @deny (create): If the user is not creating their own profile.
     * @deny (update, delete): If the user is not the owner of the profile or the document does not exist.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && resource != null;
      allow delete: if isOwner(userId) && resource != null;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }
  }
}