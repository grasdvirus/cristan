/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for user profiles
 * and allows public read access to slides, projects, and videos. Contract submissions
 * are writable by authenticated users.
 *
 * Data Structure:
 * - /slides/{slideId}: Publicly readable slides.
 * - /projects/{projectId}: Publicly readable projects.
 * - /videos/{videoId}: Publicly readable videos.
 * - /users/{userId}: User profiles, accessible only to the owning user.
 * - /submissions/{submissionId}: Contract submissions, writable by authenticated users.
 *
 * Key Security Decisions:
 * - Slides, projects, and videos are publicly readable (get, list).
 * - User profiles are private and only accessible to the owning user.
 * - Contract submissions are writable by authenticated users, allowing them to submit request.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows public read access to slides and restricts write access.
     * @path /slides/{slideId}
     * @allow (get, list): Any user can read slides.
     * @allow (create, update, delete): No one can write slides.
     * @deny (create, update, delete): Any user cannot write slides.
     * @principle Allows public read access to content and restricts write access.
     */
    match /slides/{slideId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows public read access to projects and restricts write access.
     * @path /projects/{projectId}
     * @allow (get, list): Any user can read projects.
     * @allow (create, update, delete): No one can write projects.
     * @deny (create, update, delete): Any user cannot write projects.
     * @principle Allows public read access to content and restricts write access.
     */
    match /projects/{projectId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows public read access to videos and restricts write access.
     * @path /videos/{videoId}
     * @allow (get, list): Any user can read videos.
     * @allow (create, update, delete): No one can write videos.
     * @deny (create, update, delete): Any user cannot write videos.
     * @principle Allows public read access to content and restricts write access.
     */
    match /videos/{videoId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Manages user profiles, allowing only the owner to read and write.
     * @path /users/{userId}
     * @allow (get, list): Only the user with matching id can read its profile.
     * @allow (create): Only the user with matching id can create its profile.
     * @allow (update, delete): Only the user with matching id can update or delete its profile.
     * @deny (get, create, update, delete): Any user cannot read, create, update or delete other user profiles.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Manages submissions, allowing authenticated users to create, and delete them.
     * @path /submissions/{submissionId}
     * @allow (get, list): Denied to any user.
     * @allow (create): Any signed in user can create a submission.
     * @allow (update): Denied to any user.
     * @allow (delete): Any signed in user can delete a submission.
     * @deny (get, list, update): Any user cannot get, list, or update submissions.
     * @principle Allows submission creation by signed-in users.
     */
    match /submissions/{submissionId} {
      allow get, list: if false;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if isSignedIn();
    }
  }

  // Helper functions
  function isSignedIn() {
    return request.auth != null;
  }

  function isOwner(userId) {
    return request.auth.uid == userId;
  }

  function isExistingOwner(userId) {
    return isOwner(userId) && resource != null;
  }
}