/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a public read-only policy for content collections (slides, projects, videos, games)
 * and a strict user-ownership model for user profiles. Contract submissions are publicly writable.
 *
 * Data Structure:
 * - /slides/{slideId}: Publicly readable slides.
 * - /projects/{projectId}: Publicly readable projects.
 * - /videos/{videoId}: Publicly readable videos.
 * - /games/{gameId}: Publicly readable games.
 * - /users/{userId}: User profiles, only accessible to the owner.
 * - /submissions/{submissionId}: Publicly writable contract submissions.
 * - /avis/{avisId}: Publicly readable avis.
 * - /avis/{avisId}/reponses/{reponseId}: Publicly readable reponses to an avis.
 *
 * Key Security Decisions:
 * - Public read access for slides, projects, videos, and games.
 * - User profiles are strictly private, accessible only to the owner.
 * - Anyone can create contract submissions, but they cannot be updated or deleted.
 *
 * Denormalization for Authorization:
 * - The 'games' collection is missing an ownership field.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /**
     * @description Allows public read access to slides.
     * @path /slides/{slideId}
     * @allow (get, list) Any user can read slide data.
     * @deny (create, update, delete) No user can create, update, or delete slides.
     * @principle Public read-only access.
     */
    match /slides/{slideId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows public read access to projects.
     * @path /projects/{projectId}
     * @allow (get, list) Any user can read project data.
     * @deny (create, update, delete) No user can create, update, or delete projects.
     * @principle Public read-only access.
     */
    match /projects/{projectId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows public read access to videos.
     * @path /videos/{videoId}
     * @allow (get, list) Any user can read video data.
     * @deny (create, update, delete) No user can create, update, or delete videos.
     * @principle Public read-only access.
     */
    match /videos/{videoId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows public read access to games.  Write permissions are restricted.
     * @path /games/{gameId}
     * @allow (get, list) Any user can read game data.
     * @deny (update, delete) No user can update, or delete games.
     * @allow create: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
     * @principle Public read-only access with restricted writes.
     */
    match /games/{gameId} {
      allow get, list: if true;
      allow create: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
      allow update, delete: if false;
    }

    /**
     * @description Allows only the owner to read, update, and delete their own profile.  Allows self-creation.
     * @path /users/{userId}
     * @allow (get, list, update, delete) Only the user with matching userId can access.
     * @allow (create) A user can create their own profile if the userId matches their auth UID.
     * @deny (get, list, update, delete) Access is denied if the userId does not match the authenticated user's UID.
     * @principle Enforces strict user-ownership for profile data.
     */
    match /users/{userId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allows anyone to create a contract submission, but no one can update or delete them.
     * @path /submissions/{submissionId}
     * @allow (create) Any authenticated user can create a submission.
     * @deny (get, list, update, delete) No one can get, list, update, or delete submissions.
     * @principle Public write-only for submissions.
     */
    match /submissions/{submissionId} {
      allow create: if isSignedIn();
      allow get, list, update, delete: if false;
    }

     /**
     * @description Allows public read access to avis.
     * @path /avis/{avisId}
     * @allow (get, list) Any user can read avis data.
     * @deny (create, update, delete) No user can create, update, or delete avis.
     * @principle Public read-only access.
     */
    match /avis/{avisId} {
        allow get, list: if true;
        allow create, update, delete: if false;

        /**
         * @description Allows public read access to reponses to an avis.
         * @path /avis/{avisId}/reponses/{reponseId}
         * @allow (get, list) Any user can read reponse data.
         * @deny (create, update, delete) No user can create, update, or delete reponses.
         * @principle Public read-only access.
         */
        match /reponses/{reponseId} {
            allow get, list: if true;
            allow create, update, delete: if false;
        }
    }
  }

  // Helper functions
  function isSignedIn() {
    return request.auth != null;
  }

  function isOwner(userId) {
    return request.auth.uid == userId;
  }

  function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
  }
}