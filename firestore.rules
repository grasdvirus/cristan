/**
 * @fileoverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset enforces a user-ownership model for user profiles, allowing each authenticated user to manage their own profile data.
 * Videos, Projects, Slides, and Games are publicly accessible for reading.
 * Creating, updating, or deleting content is restricted to prevent unauthorized client-side modifications.
 * Comments and likes are associated with videos and are secured by requiring a valid user ID.
 *
 * Data Structure:
 * - /users/{userId}/userProfile: Stores individual user profiles.
 * - /videos/{videoId}: Stores video metadata.
 * - /videos/{videoId}/comments/{commentId}: Stores comments for each video.
 * - /videos/{videoId}/likes/{likeId}: Stores likes for each video.
 * - /slides/{slideId}: Stores hero carousel slides.
 * - /projects/{projectId}: Stores project details.
 * - /games/{gameId}: Stores game/affiliate information.
 * - /submissions/{submissionId}: Stores user-submitted forms.
 *
 * Key Security Decisions:
 * - User profiles are strictly private.
 * - Public content (videos, projects, slides, games) is readable by anyone.
 * - Write operations on public content are disallowed from the client.
 * - Form submissions are write-only for authenticated users.
 * - Comments and likes can be created by any authenticated user.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    match /users/{userId}/{document=**} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }
      allow read, write: if isOwner();
    }
    
    match /slides/{slideId} {
        allow get, list: if true;
        allow create, update, delete: if false;
    }

    match /projects/{projectId} {
        allow get, list: if true;
        allow create, update, delete: if false;
    }
    
    match /videos/{videoId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    match /games/{gameId} {
        allow get, list: if true;
        allow create, update, delete: if false;
    }

    match /submissions/{submissionId} {
        allow read, delete: if false;
        allow create: if isSignedIn();
        allow update: if false;
    }

    match /avis/{avisId}/{document=**} {
       allow read: if true;
       allow create, update, delete: if isSignedIn();
    }

    match /videos/{videoId}/comments/{commentId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    match /videos/{videoId}/likes/{likeId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }
  }
}
