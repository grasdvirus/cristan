
rules_version = '2';
service cloud.firestore {
    
      match /databases/{database}/documents {
            
                function isAdmin() {
                        return request.auth != null && request.auth.token.email == 'grasdvirus@gmail.com';
                }

                    match /users/{userId} {
                            allow read, write: if request.auth != null && request.auth.uid == userId;
                                  allow list: if false;
                    }

                        match /videos/{videoId} {
                                allow get, list: if true;
                                      allow create, update, delete: if isAdmin();

                                            match /comments/{commentId} {
                                                      allow get, list: if true;
                                                              allow create: if request.auth != null;
                                                                      allow update, delete: if false; 
                                            }

                                                  match /likes/{likeId} {
                                                            allow get, list: if true;
                                                                    allow create: if request.auth != null;
                                                                            allow delete: if request.auth != null && resource.data.userProfileId == request.auth.uid;
                                                                                    allow update: if false;
                                                  }
                        }

                            match /frameworks/{frameworkId} {
                                    allow get, list: if true;
                                          allow create, update, delete: if isAdmin();
                            }
                                
                                    match /projects/{projectId} {
                                            allow get, list: if true;
                                                  allow create, update, delete: if isAdmin();
                                    }

                                        match /slides/{slideId} {
                                                allow get, list: if true;
                                                      allow create, update, delete: if isAdmin();
                                        }

                                        match /promoVideos/{promoVideoId} {
                                            allow get, list: if true;
                                            allow create, update, delete: if isAdmin();
                                        }
                                            
                                                match /submissions/{submissionId} {
                                                        allow get: if isAdmin() || (request.auth != null && request.auth.uid == submissionId);
                                                        allow list: if isAdmin();
                                                        allow create: if request.auth != null;
                                                                  
                                                        allow update: if isAdmin();
                                                        allow delete: if isAdmin();
                                                }
                                                    
                                                        match /avis/{avisId} {
                                                                allow get, list: if true;
                                                                      allow create: if request.auth != null;
                                                                            allow update, delete: if false;
                                                                                  
                                                                                        match /reponses/{reponseId} {
                                                                                                   allow get, list: if true;
                                                                                                            allow create: if request.auth != null;
                                                                                                                     allow update, delete: if false;
                                                                                        }
                                                        }

                                                            match /games/{gameId} {
                                                                    allow get, list: if true;
                                                                          allow create, update, delete: if isAdmin();
                                                            }
                                                            
                                                                match /news/{newsItemId} {
                                                                    allow get, list: if true;
                                                                    allow create, update, delete: if isAdmin();
                                                                }

                                                                match /marqueeItems/{marqueeItemId} {
                                                                    allow get, list: if true;
                                                                    allow create, update, delete: if isAdmin();
                                                                }
                                                                
                                                                match /partnerMarqueeItems/{partnerMarqueeItemId} {
                                                                    allow get, list: if true;
                                                                    allow create, update, delete: if isAdmin();
                                                                }

                                                                match /avisClients/{avisClientId} {
                                                                    allow get, list: if true;
                                                                    allow create, update, delete: if isAdmin();
                                                                }

                                                                match /partnerMessages/{messageId} {
                                                                    allow list, get: if request.auth != null;
                                                                    allow create, update, delete: if isAdmin();
                                                                }
                                                                
                                                                match /presentationAudioScripts/{scriptId} {
                                                                    allow read, write: if isAdmin();
                                                                }
      }
}

    