rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /**
     * @description Checks if the request is made by an authenticated user.
     * @return {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user's UID matches the provided userId.
     * @param {string} userId The user ID to compare against.
     * @return {boolean} True if the authenticated user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description
     *   This ruleset enforces a flexible data structure during prototyping. Authorization is strictly enforced,
     *   but schema validation is relaxed to allow for rapid iteration.
     *
     * Data Structure:
     *   - Top-level collections for 'slides', 'projects', and 'videos'.
     *   - A 'users' collection where each document represents a user profile, accessible only by the user.
     *
     * Key Security Decisions:
     *   - Public read access for 'slides', 'projects', and 'videos'.
     *   - Owner-only write access for 'slides', 'projects', and 'videos', enforced through a schema-denormalized `authorId` field.
     *   - Strict user-ownership for profiles under `/users/{userId}`.
     *   - In this prototyping phase, schema validation is omitted for data fields, focusing on authorization and relationship integrity.
     *
     * Denormalization for Authorization:
     *   - The rules assume the presence of an `authorId` field on the 'slides', 'projects', and 'videos' documents to enforce write permissions.
     *
     * Structural Segregation:
     *   - Private user data (profiles) is stored in a dedicated `/users/{userId}` collection, separate from the public collections.
     */

    match /slides/{slideId} {
      allow get: if true;
      allow list: if true;
      allow create, update, delete: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
    }

    match /projects/{projectId} {
      allow get: if true;
      allow list: if true;
      allow create, update, delete: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
    }

    match /videos/{videoId} {
      allow get: if true;
      allow list: if true;
      allow create, update, delete: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }
  }
}