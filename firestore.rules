
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'grasdvirus@gmail.com';
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow list: if false;
    }

    match /videos/{videoId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();

      match /comments/{commentId} {
        allow get, list: if true;
        allow create: if request.auth != null;
        allow update, delete: if false; 
      }

      match /likes/{likeId} {
        allow get, list: if true;
        allow create: if request.auth != null;
        allow delete: if request.auth != null && resource.data.userProfileId == request.auth.uid;
        allow update: if false;
      }
    }

    match /frameworks/{frameworkId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }
    
    match /projects/{projectId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /slides/{slideId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }
    
    match /submissions/{submissionId} {
      // Admins can do anything.
      allow read, write: if isAdmin();
      
      // Anyone can create a submission (contact form, partner application).
      allow create: if true;
      
      // A user can get or update their own submission document if they are logged in.
      allow get, update: if request.auth != null && request.auth.uid == submissionId;
    }
    
    match /avis/{avisId} {
      allow get, list: if true;
      allow create: if request.auth != null;
      allow update, delete: if false;
      
      match /reponses/{reponseId} {
         allow get, list: if true;
         allow create: if request.auth != null;
         allow update, delete: if false;
      }
    }

    match /games/{gameId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
