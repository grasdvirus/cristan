/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a role-based access control model.
 *
 * Data Structure:
 * - /slides/{slideId}: Stores publicly accessible hero carousel slides.
 * - /projects/{projectId}: Stores publicly accessible internet projects.
 * - /videos/{videoId}: Stores publicly accessible TV videos.
 * - /users/{userId}: Stores private user profile information, accessible only to the user.
 * - /submissions/{submissionId}: Stores contract form submissions, only accessible if authenticated.
 *
 * Key Security Decisions:
 * - Slides, Projects and Videos collections are publicly readable.
 * - Users collection is private and only accessible by the owner.
 * - Submissions collection is only writable if authenticated.
 *
 * Denormalization for Authorization:
 * - None. All authorization decisions are based on path and authentication state.
 *
 * Structural Segregation:
 * - Public content (slides, projects, videos) are stored in top-level collections for easy public access.
 * - Private user data (user profiles) are stored under /users/{userId} to ensure isolation.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to read slides, but only authenticated users to create, update or delete them.
     * @path /slides/{slideId}
     * @allow (get, list)
     * @deny (create, update, delete)
     * @principle Public read, authenticated write.
     */
    match /slides/{slideId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }

    /**
     * @description Allows anyone to read projects, but only authenticated users to create, update or delete them.
     * @path /projects/{projectId}
     * @allow (get, list)
     * @deny (create, update, delete)
     * @principle Public read, authenticated write.
     */
    match /projects/{projectId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }

    /**
     * @description Allows anyone to read videos, but only authenticated users to create, update or delete them.
     * @path /videos/{videoId}
     * @allow (get, list)
     * @deny (create, update, delete)
     * @principle Public read, authenticated write.
     */
    match /videos/{videoId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }

    /**
     * @description Allows a user to read, create, update, and delete their own profile.
     * @path /users/{userId}
     * @allow (create) - User with ID 'user123' can create their profile.
     * @allow (get, list, update, delete) - User with ID 'user123' can read, list, update, and delete their own profile.
     * @deny (create, get, list, update, delete) - User with ID 'user456' cannot access the profile of user with ID 'user123'.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      allow create: if isOwner(userId);
      allow get, list, update, delete: if isOwner(userId);
    }
    
     /**
     * @description Allows authenticated users to create contract submissions.
     * @path /submissions/{submissionId}
     * @allow create: if isSignedIn();
     * @deny get, list, update, delete: if true;
     * @principle Authenticated write.
     */
    match /submissions/{submissionId} {
        allow create: if isSignedIn();
        allow get, list, update, delete: if false;
    }


    // --- Helper functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }
  }
}