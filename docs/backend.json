
{
  "entities": {
    "Slide": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Slide",
      "type": "object",
      "description": "Represents a slide in the hero carousel.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the slide."
        },
        "description": {
          "type": "string",
          "description": "The main text/title displayed on the slide."
        },
        "imageUrl": {
          "type": "string",
          "description": "URL of the background image for the slide.",
          "format": "uri"
        },
        "imageHint": {
          "type": "string",
          "description": "AI hint for the image."
        }
      },
      "required": ["id", "description", "imageUrl"]
    },
    "Project": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Project",
      "type": "object",
      "description": "Represents a project in the 'Internet' section.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the project."
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "longDescription": {
          "type": "string"
        },
        "price": {
          "type": "string"
        },
        "technologies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "liveUrl": {
          "type": "string",
          "format": "uri"
        },
        "imageUrl": {
          "type": "string",
          "format": "uri"
        },
        "imageHint": {
          "type": "string"
        }
      },
      "required": ["id", "title", "description", "longDescription", "price", "technologies", "imageUrl"]
    },
    "Video": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Video",
      "type": "object",
      "description": "Represents a video in the 'TV' section.",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "uploadDate": {
          "type": "string"
        },
        "views": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "videoUrl": {
          "type": "string",
          "format": "uri"
        },
        "thumbnailUrl": {
          "type": "string",
          "format": "uri"
        },
        "thumbnailHint": {
          "type": "string"
        }
      },
      "required": ["id", "title", "description", "videoUrl", "thumbnailUrl"]
    },
    "Game": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Game",
      "type": "object",
      "description": "Represents a game for affiliation.",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "affiliateUrl": {
          "type": "string",
          "format": "uri"
        },
        "imageUrl": {
          "type": "string",
          "format": "uri"
        },
        "imageHint": {
          "type": "string"
        }
      },
      "required": ["id", "title", "description", "category", "affiliateUrl", "imageUrl"]
    },
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserProfile",
      "type": "object",
      "description": "Represents a user's profile.",
      "properties": {
        "bio": {
          "type": "string",
          "description": "User's biography."
        },
        "skills": {
          "type": "array",
          "description": "List of user's skills.",
          "items": {
            "type": "string"
          }
        },
        "contactInfo": {
          "type": "string",
          "description": "User's contact information."
        }
      },
      "required": ["bio", "skills", "contactInfo"]
    },
    "ContractSubmission": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "ContractSubmission",
      "type": "object",
      "description": "Represents a submission from the contract form.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the submission."
        },
        "fullName": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "phone": {
          "type": "string"
        },
        "companyName": {
          "type": "string"
        },
        "projectDetails": {
          "type": "string"
        },
        "projectId": {
          "type": "string"
        },
        "createdAt": {
            "type": "string",
            "format": "date-time"
        },
        "type": {
            "type": "string",
            "description": "Type of submission, e.g., 'Projet' or 'Partenariat'"
        },
        "socialLinks": {
          "type": "array",
          "items": { "type": "string", "format": "uri" }
        },
        "promoCode": {
          "type": "string"
        }
      },
      "required": ["fullName", "email", "phone", "createdAt", "type"]
    },
     "Avis": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Avis",
      "type": "object",
      "description": "Represents a review/comment left by a user.",
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userPhotoURL": { "type": "string", "format": "uri" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "text", "userId", "userName", "createdAt"]
    },
    "ReponseAvis": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "ReponseAvis",
      "type": "object",
      "description": "Represents a reply to a review/comment.",
      "properties": {
        "id": { "type": "string" },
        "avisId": { "type": "string" },
        "text": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userPhotoURL": { "type": "string", "format": "uri" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "avisId", "text", "userId", "userName", "createdAt"]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous",
      "google.com"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/slides/{slideId}",
        "definition": {
          "schema": {
            "$ref": "#/entities/Slide"
          },
          "description": "Stores hero carousel slides.",
          "params": [
            {
              "name": "slideId",
              "description": "Unique identifier for the slide."
            }
          ]
        }
      },
      {
        "path": "/projects/{projectId}",
        "definition": {
          "schema": {
            "$ref": "#/entities/Project"
          },
          "description": "Stores internet projects.",
          "params": [
            {
              "name": "projectId",
              "description": "Unique identifier for the project."
            }
          ]
        }
      },
      {
        "path": "/videos/{videoId}",
        "definition": {
          "schema": {
            "$ref": "#/entities/Video"
          },
          "description": "Stores TV videos.",
          "params": [
            {
              "name": "videoId",
              "description": "Unique identifier for the video."
            }
          ]
        }
      },
      {
        "path": "/games/{gameId}",
        "definition": {
          "schema": {
            "$ref": "#/entities/Game"
          },
          "description": "Stores affiliate games.",
          "params": [
            {
              "name": "gameId",
              "description": "Unique identifier for the game."
            }
          ]
        }
      },
      {
        "path": "/users/{userId}",
        "definition": {
          "schema": {
            "$ref": "#/entities/UserProfile"
          },
          "description": "Stores user profile information.",
          "params": [
            {
              "name": "userId",
              "description": "Unique identifier for the user."
            }
          ]
        }
      },
       {
        "path": "/submissions/{submissionId}",
        "definition": {
          "schema": {
            "$ref": "#/entities/ContractSubmission"
          },
          "description": "Stores contract form submissions.",
          "params": [
            {
              "name": "submissionId",
              "description": "Unique identifier for the submission."
            }
          ]
        }
      },
      {
        "path": "/avis/{avisId}",
        "definition": {
          "schema": { "$ref": "#/entities/Avis" },
          "description": "Stores user reviews/comments.",
          "params": [
            { "name": "avisId", "description": "Unique identifier for the review." }
          ]
        },
        "subcollections": [
            {
                "path": "/avis/{avisId}/reponses/{reponseId}",
                "definition": {
                    "schema": { "$ref": "#/entities/ReponseAvis"},
                    "description": "Stores replies to a specific review.",
                    "params": [
                        { "name": "avisId", "description": "ID of the parent review." },
                        { "name": "reponseId", "description": "Unique identifier for the reply."}
                    ]
                }
            }
        ]
      }
    ]
  }
}
