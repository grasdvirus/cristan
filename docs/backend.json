{
  "entities": {
    "Slide": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Slide",
      "type": "object",
      "description": "Represents a slide in the hero carousel.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the slide."
        },
        "description": {
          "type": "string",
          "description": "The main text/title displayed on the slide."
        },
        "imageUrl": {
          "type": "string",
          "description": "URL of the background image for the slide.",
          "format": "uri"
        },
        "imageHint": {
          "type": "string",
          "description": "AI hint for the image."
        }
      },
      "required": ["id", "description", "imageUrl"]
    },
    "Project": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Project",
      "type": "object",
      "description": "Represents a project in the 'Internet' section.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the project."
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "longDescription": {
          "type": "string"
        },
        "price": {
          "type": "string"
        },
        "technologies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "liveUrl": {
          "type": "string",
          "format": "uri"
        },
        "imageUrl": {
          "type": "string",
          "format": "uri"
        },
        "imageHint": {
          "type": "string"
        }
      },
      "required": ["id", "title", "description", "longDescription", "price", "technologies", "imageUrl"]
    },
    "Video": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Video",
      "type": "object",
      "description": "Represents a video in the 'TV' section.",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "uploadDate": {
          "type": "string"
        },
        "views": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "videoUrl": {
          "type": "string",
          "format": "uri"
        },
        "thumbnailUrl": {
          "type": "string",
          "format": "uri"
        },
        "thumbnailHint": {
          "type": "string"
        }
      },
      "required": ["id", "title", "uploadDate", "views", "description", "videoUrl", "thumbnailUrl"]
    },
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserProfile",
      "type": "object",
      "description": "Represents a user's profile.",
      "properties": {
        "bio": {
          "type": "string",
          "description": "User's biography."
        },
        "skills": {
          "type": "array",
          "description": "List of user's skills.",
          "items": {
            "type": "string"
          }
        },
        "contactInfo": {
          "type": "string",
          "description": "User's contact information."
        }
      },
      "required": ["bio", "skills", "contactInfo"]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/slides/{slideId}",
        "definition": {
          "schema": {
            "$ref": "#/entities/Slide"
          },
          "description": "Stores hero carousel slides.",
          "params": [
            {
              "name": "slideId",
              "description": "Unique identifier for the slide."
            }
          ]
        }
      },
      {
        "path": "/projects/{projectId}",
        "definition": {
          "schema": {
            "$ref": "#/entities/Project"
          },
          "description": "Stores internet projects.",
          "params": [
            {
              "name": "projectId",
              "description": "Unique identifier for the project."
            }
          ]
        }
      },
      {
        "path": "/videos/{videoId}",
        "definition": {
          "schema": {
            "$ref": "#/entities/Video"
          },
          "description": "Stores TV videos.",
          "params": [
            {
              "name": "videoId",
              "description": "Unique identifier for the video."
            }
          ]
        }
      },
      {
        "path": "/users/{userId}",
        "definition": {
          "schema": {
            "$ref": "#/entities/UserProfile"
          },
          "description": "Stores user profile information.",
          "params": [
            {
              "name": "userId",
              "description": "Unique identifier for the user."
            }
          ]
        }
      }
    ]
  }
}
